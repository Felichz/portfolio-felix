// Felix's portfolio on Cloudflare Workers (static assets). Production: felix.medanolabs.com
// Deploy from this machine: `npm run deploy` (or `npm run deploy:staging`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-felix",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [{ "pattern": "felix.medanolabs.com", "custom_domain": true }],
  "env": {
    "staging": {
      "name": "portfolio-felix-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "felix-stg.medanolabs.com", "custom_domain": true }]
    }
  }
}
