---
import Icon from './Icon.astro';
---

<section id="top" class="hero">
  <div class="wrap">
    <h1 class="hero-name">Felix Andersson</h1>
    <div class="hero-band">
      <div class="hero-intro">
        <p class="hero-role">Senior Frontend Engineer</p>
        <p class="t-lede hero-lede">
          Five years on Cisco’s Magnetic design system and the Meraki Dashboard, where I built data tables that stay at
          60&nbsp;FPS with more than 100,000 rows. This year I also designed and shipped five products of my own.
        </p>
        <div class="hero-actions">
          <a class="btn btn--solid" href="mailto:andersson.fx@gmail.com"><Icon name="mail" />Email me</a>
          <a class="btn" href="/felix-andersson-resume.pdf" target="_blank" rel="noopener">Résumé<span class="btn-note">PDF</span></a>
          <span class="hero-socials">
            <a class="icon-btn" href="https://github.com/Felichz" target="_blank" rel="noopener" aria-label="GitHub profile"><Icon name="github" /></a>
            <a class="icon-btn" href="https://www.linkedin.com/in/felixandersson/" target="_blank" rel="noopener" aria-label="LinkedIn profile"><Icon name="linkedin" /></a>
          </span>
        </div>
      </div>
      <dl class="hero-meta">
        <div>
          <dt class="t-label">Based in</dt>
          <dd>Montevideo, Uruguay</dd>
        </div>
        <div>
          <dt class="t-label">Local time</dt>
          <dd class="t-num"><time data-clock></time><span class="muted">UTC−3</span></dd>
        </div>
        <div>
          <dt class="t-label">Open to</dt>
          <dd>Remote senior frontend roles</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(28px, 3.6vw, 52px);
    padding-bottom: clamp(40px, 4.4vw, 64px);
  }
  .hero-name {
    font-size: clamp(3.25rem, 0.9rem + 8.2vw, 6rem);
    line-height: 0.9;
    font-weight: 820;
    font-stretch: 112%;
    letter-spacing: -0.04em;
  }
  .hero-band {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: 32px clamp(32px, 6vw, 120px);
    margin-top: clamp(24px, 2.6vw, 36px);
    align-items: end;
  }
  .hero-intro { display: grid; gap: 18px; justify-items: start; }
  .hero-role {
    font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.625rem);
    line-height: 1.15;
    font-weight: 700;
    font-stretch: 92%;
    letter-spacing: -0.015em;
  }
  .hero-lede { max-width: 58ch; color: var(--ink-2); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-top: 4px; }
  .hero-socials { display: inline-flex; gap: 10px; }
  .btn-note { font-size: 0.75rem; font-weight: 600; color: var(--ink-3); letter-spacing: 0.02em; }

  .hero-meta { display: grid; border-top: 1px solid var(--rule); }
  .hero-meta > div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    padding-block: 11px;
    border-bottom: 1px solid var(--rule);
  }
  .hero-meta dd { font-weight: 560; font-size: 0.975rem; }
  .hero-meta time { margin-right: 8px; }
  .hero-meta time:empty { display: none; }

  @media (max-width: 900px) {
    .hero-band { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 420px) {
    .btn-note { display: none; }
  }
</style>

<script>
  // Montevideo's local time, so a remote team can see the overlap at a glance.
  const el = document.querySelector<HTMLTimeElement>('[data-clock]');
  if (el) {
    const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'America/Montevideo', hour: '2-digit', minute: '2-digit' });
    const tick = () => {
      el.textContent = fmt.format(new Date());
    };
    tick();
    // Re-render on the minute boundary, then every minute.
    setTimeout(() => {
      tick();
      setInterval(tick, 60_000);
    }, 60_000 - (Date.now() % 60_000));
  }
</script>
