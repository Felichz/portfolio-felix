---
import { Picture, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
const t = p.theme;
const style = [
  `--s-ground:${t.ground}`,
  `--s-surface:${t.surface}`,
  `--s-ink:${t.ink}`,
  `--s-muted:${t.muted}`,
  `--s-rule:${t.rule}`,
  `--s-accent:${t.accent}`,
  `--s-accent-text:${t.accentText}`,
  `--s-on-accent:${t.onAccent}`,
  `color-scheme:${t.scheme}`,
].join(';');

// Full-size versions for the image viewer.
const full = async (src: ImageMetadata) => (await getImage({ src, format: 'webp', width: Math.min(src.width, 2880), quality: 82 })).src;
const mainFull = await full(p.main.src);
const secondFull = p.second ? await full(p.second.src) : null;
const stripFull = await Promise.all(p.strip.map((s) => full(s.src)));
---

<section id={p.id} class="spec surface" style={style} data-paint data-scheme={t.scheme} aria-labelledby={`${p.id}-name`}>
  <div class="wrap">
    <header class="spec-head">
      <h2 id={`${p.id}-name`} class={`spec-name ${p.face}`}>
        {
          p.wordmark ? (
            <>
              <b>{p.wordmark[0]}</b>
              {p.wordmark[1]}
            </>
          ) : (
            p.name
          )
        }
      </h2>
      <p class="spec-tagline">{p.tagline}</p>
      <div class="spec-links">
        <a class="btn btn--accent" href={p.live} target="_blank" rel="noopener">
          Open the live app
          <Icon name="arrow-up-right" />
        </a>
        <a class="btn" href={p.source} target="_blank" rel="noopener">
          <Icon name="github" />
          Source
        </a>
      </div>
    </header>

    <div class={`spec-stage ${p.second ? `has-${p.second.kind}` : ''}`}>
      <figure class="spec-main">
        <div class="plate">
          <button class="zoom" type="button" data-zoom={mainFull} data-alt={p.main.alt} aria-label={`Enlarge screenshot: ${p.name}`}>
            <Picture
              src={p.main.src}
              alt={p.main.alt}
              formats={['avif', 'webp']}
                    fallbackFormat="webp"
              widths={[640, 960, 1280, 1600, 2000]}
              sizes="(min-width: 1400px) 1000px, (min-width: 1100px) 70vw, 100vw"
              loading="lazy"
              decoding="async"
            />
          </button>
          {
            p.callouts.map((c, i) => (
              <span class="pin" style={`left:${c.x}%;top:${c.y}%`} data-pin={i + 1} aria-hidden="true">
                {i + 1}
              </span>
            ))
          }
          <span class="crop" aria-hidden="true"></span>
        </div>
      </figure>

      {
        p.second && (
          <figure class={`spec-second spec-second--${p.second.kind}`}>
            <div class="plate">
              <button class="zoom" type="button" data-zoom={secondFull} data-alt={p.second.alt} aria-label={`Enlarge screenshot: ${p.name}, ${p.second.kind === 'phone' ? 'on a phone' : 'second view'}`}>
                <Picture
                  src={p.second.src}
                  alt={p.second.alt}
                  formats={['avif', 'webp']}
                    fallbackFormat="webp"
                  widths={p.second.kind === 'phone' ? [300, 480, 720] : [480, 800, 1200]}
                  sizes={p.second.kind === 'phone' ? '260px' : '(min-width: 1100px) 34vw, 70vw'}
                  loading="lazy"
                  decoding="async"
                />
              </button>
            </div>
          </figure>
        )
      }
    </div>

    <div class="spec-body">
      <div class="spec-story prose">
        {p.story.map((para) => <p>{para}</p>)}
        {p.liveNote && <p class="spec-note">{p.liveNote}</p>}
      </div>

      <ol class="spec-callouts" aria-label="Details in the screenshot">
        {
          p.callouts.map((c, i) => (
            <li data-callout={i + 1}>
              <span class="pin pin--static" aria-hidden="true">
                {i + 1}
              </span>
              <span>{c.text}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <ul class="spec-highlights">
      {
        p.highlights.map((h) => (
          <li>
            <h3>{h.title}</h3>
            <p>{h.body}</p>
          </li>
        ))
      }
    </ul>

    <dl class="spec-sheet">
      <div class="sheet-cell sheet-cell--role">
        <dt class="t-label">Role</dt>
        <dd>{p.role}</dd>
      </div>
      <div class="sheet-cell sheet-cell--stack">
        <dt class="t-label">Stack</dt>
        <dd>{p.stack.join(', ')}</dd>
      </div>
      <div class="sheet-cell">
        <dt class="t-label">Scale</dt>
        <dd>
          <ul class="sheet-list t-num">{p.scale.map((s) => <li>{s}</li>)}</ul>
        </dd>
      </div>
      <div class="sheet-cell">
        <dt class="t-label">Typefaces</dt>
        <dd>
          <ul class="sheet-faces">
            {
              p.typefaces.map((f) => (
                <li>
                  <span class={`sheet-aa ${f.family}`} aria-hidden="true">
                    Aa
                  </span>
                  <span>
                    <span class={`sheet-face-name ${f.family}`}>{f.name}</span>
                    <span class="sheet-face-use">{f.use}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </dd>
      </div>
      <div class="sheet-cell sheet-cell--palette">
        <dt class="t-label">Palette</dt>
        <dd>
          <ul class="sheet-palette">
            {
              p.palette.map((c) => (
                <li>
                  <span class="chip" style={`background:${c.hex}`} aria-hidden="true" />
                  <span class="chip-name">{c.name}</span>
                  <span class="chip-hex t-num">{c.hex}</span>
                </li>
              ))
            }
          </ul>
        </dd>
      </div>
    </dl>

    {
      p.strip.length > 0 && (
        <ul class="spec-strip" aria-label={`More screens from ${p.name}`}>
          {p.strip.map((s, i) => (
            <li>
              <button class="zoom strip-item" type="button" data-zoom={stripFull[i]} data-alt={s.alt} aria-label={`Enlarge screenshot: ${s.caption ?? s.alt}`}>
                <span class="plate">
                  <Picture
                    src={s.src}
                    alt={s.alt}
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    widths={[400, 640, 900]}
                    sizes="(min-width: 1100px) 30vw, 80vw"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                {s.caption && <span class="strip-cap">{s.caption}</span>}
              </button>
            </li>
          ))}

        </ul>
      )
    }

    <p class="spec-folio t-label">
      <span>{p.name}</span>
      <span>Set in {p.typefaces.map((f) => f.name).join(' and ')}</span>
      <span class="t-num">Ground {t.ground}</span>
      <span>{p.note ?? 'Interface in English'}</span>
    </p>
  </div>
</section>

<style>
  .spec {
    padding-block: var(--section-y);
    position: relative;
  }

  /* ---- Head ---- */
  .spec-head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-areas:
      'name name'
      'tag links';
    gap: 20px clamp(24px, 4vw, 64px);
    align-items: end;
  }
  .spec-name {
    grid-area: name;
    font-size: clamp(3rem, 1rem + 7vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    font-weight: inherit;
  }
  .spec-name.face-martian {
    font-weight: 400;
    letter-spacing: -0.02em;
    font-size: clamp(2.5rem, 0.8rem + 6vw, 5.25rem);
  }
  .spec-name.face-martian b { font-weight: 700; }
  .spec-name.face-newsreader { letter-spacing: -0.035em; }
  .spec-name.face-inter { letter-spacing: -0.04em; }
  .spec-name.face-bricolage { letter-spacing: -0.04em; }
  .spec-tagline {
    grid-area: tag;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.4375rem);
    line-height: 1.4;
    max-width: 44ch;
    letter-spacing: -0.005em;
  }
  .spec-links {
    grid-area: links;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-end;
  }
  .spec .btn { --b-line: color-mix(in srgb, var(--s-ink) 30%, transparent); }
  .spec .btn--accent { --b-line: var(--s-accent); }

  /* ---- Stage ---- */
  .spec-stage {
    position: relative;
    margin-top: clamp(40px, 5vw, 72px);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .spec-stage.has-phone { padding-right: clamp(0px, 9vw, 150px); }
  .spec-stage.has-screen { padding-right: clamp(0px, 16vw, 260px); padding-bottom: clamp(0px, 8vw, 140px); }
  .spec-main { min-width: 0; }
  .spec-second {
    position: absolute;
    right: 0;
    z-index: 3;
  }
  .spec-second--phone {
    bottom: clamp(-60px, -4vw, -24px);
    width: clamp(160px, 17vw, 250px);
  }
  .spec-second--phone .plate,
  .spec-second--phone .plate :global(img),
  .spec-second--phone .zoom { border-radius: 22px; }
  .spec-second--phone .plate {
    padding: 6px;
    background: #0e0e10;
    border-radius: 28px;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 0 0 1px color-mix(in srgb, var(--s-ink) 14%, transparent),
      0 30px 50px -20px rgb(0 0 0 / 0.55);
  }
  .spec-second--phone .plate :global(img) { border-radius: 22px; }
  .spec-second--screen {
    bottom: 0;
    width: clamp(260px, 38%, 540px);
  }

  .pin {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    border-radius: 50%;
    background: var(--s-accent);
    color: var(--s-on-accent);
    font-size: 0.8125rem;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--s-accent) 30%, transparent),
      0 4px 10px -2px rgb(0 0 0 / 0.35);
    transition: transform 0.25s var(--ease-out);
    pointer-events: none;
  }
  .pin[data-lit] { transform: scale(1.25); }
  .pin--static {
    position: static;
    margin: 0;
    flex: none;
    box-shadow: none;
  }

  /* ---- Story + callouts ---- */
  .spec-body {
    margin-top: clamp(56px, 7vw, 96px);
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 40px clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .spec-story { font-size: clamp(1.0625rem, 1rem + 0.2vw, 1.1875rem); }
  .spec-note {
    font-size: 0.9375rem;
    color: var(--s-muted);
    padding-left: 14px;
    border-left: 1px solid var(--s-rule);
  }
  .spec-callouts {
    display: grid;
    gap: 16px;
    padding-top: 6px;
  }
  .spec-callouts li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    color: var(--s-muted);
    font-size: 0.975rem;
    line-height: 1.5;
    transition: color 0.2s var(--ease-out);
  }
  .spec-callouts li:hover { color: var(--s-ink); }

  /* ---- Highlights ---- */
  .spec-highlights {
    margin-top: clamp(56px, 7vw, 96px);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--s-ink);
  }
  .spec-highlights li {
    padding: 22px clamp(16px, 2vw, 32px) 4px 0;
  }
  .spec-highlights li + li {
    padding-left: clamp(16px, 2vw, 32px);
    border-left: 1px solid var(--s-rule);
  }
  .spec-highlights h3 {
    font-size: 1.1875rem;
    line-height: 1.25;
    font-weight: 720;
    font-stretch: 94%;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }
  .spec-highlights p { color: var(--s-muted); font-size: 0.975rem; line-height: 1.55; }

  /* ---- Specimen sheet ---- */
  .spec-sheet {
    margin: clamp(48px, 6vw, 80px) 0 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    border-top: 1px solid var(--s-rule);
    border-bottom: 1px solid var(--s-rule);
  }
  .sheet-cell {
    grid-column: span 3;
    padding: 18px clamp(12px, 1.6vw, 24px) 20px 0;
    display: grid;
    align-content: start;
    gap: 8px;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .sheet-cell + .sheet-cell { padding-left: clamp(12px, 1.6vw, 24px); border-left: 1px solid var(--s-rule); }
  .sheet-cell--role { grid-column: span 3; }
  .sheet-cell--stack { grid-column: span 3; }
  .sheet-cell--palette {
    grid-column: 1 / -1;
    border-left: 0 !important;
    padding-left: 0 !important;
    border-top: 1px solid var(--s-rule);
  }
  .sheet-list li + li { margin-top: 2px; }
  .sheet-faces { display: grid; gap: 10px; }
  .sheet-faces li { display: flex; gap: 12px; align-items: center; }
  .sheet-aa {
    font-size: 2.75rem;
    line-height: 1;
    min-width: 1.4em;
  }
  .sheet-face-name { display: block; font-size: 1rem; line-height: 1.2; }
  .sheet-face-use { display: block; color: var(--s-muted); font-size: 0.8125rem; font-family: var(--font); font-weight: 500; }
  .sheet-palette {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
  }
  .sheet-palette li { display: grid; gap: 2px; }
  .chip {
    display: block;
    height: 44px;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--s-ink) 16%, transparent);
    margin-bottom: 6px;
  }
  .chip-name { font-weight: 600; font-stretch: 92%; font-size: 0.875rem; }
  .chip-hex { color: var(--s-muted); font-size: 0.8125rem; }

  /* ---- Strip ---- */
  .spec-strip {
    margin-top: clamp(40px, 5vw, 64px);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
    align-items: start;
  }
  .strip-item { display: grid; gap: 10px; width: 100%; }
  .strip-item .plate { display: block; transition: transform 0.35s var(--ease-out); }
  .strip-item:hover .plate { transform: translateY(-3px); }
  .strip-cap { font-size: 0.875rem; font-weight: 600; font-stretch: 92%; color: var(--s-muted); }

  /* Folio: the running foot that closes every spread. */
  .spec-folio {
    margin-top: clamp(48px, 6vw, 80px);
    padding-top: 14px;
    border-top: 1px solid var(--s-rule);
    display: flex;
    flex-wrap: wrap;
    gap: 6px 28px;
  }
  .spec-folio span:first-child { color: var(--s-ink); }

  @media (max-width: 1100px) {
    .spec-head {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'name' 'tag' 'links';
      align-items: start;
    }
    .spec-links { justify-content: flex-start; }
    .spec-body { grid-template-columns: minmax(0, 1fr); }
    .sheet-cell,
    .sheet-cell--role,
    .sheet-cell--stack { grid-column: span 6; }
    .sheet-cell:nth-child(odd) { border-left: 0; padding-left: 0; }
    .sheet-cell:nth-child(n + 3) { border-top: 1px solid var(--s-rule); }
    .sheet-palette { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .spec-stage.has-phone,
    .spec-stage.has-screen { padding: 0; }
    .spec-second {
      position: relative;
      right: auto;
      bottom: auto;
      margin-top: 20px;
      justify-self: end;
    }
    .spec-second--screen { width: 64%; margin-top: -8%; margin-right: -6px; }
    .spec-second--phone { width: 38%; margin-top: -16%; margin-right: -4px; }
    .spec-highlights { grid-template-columns: minmax(0, 1fr); }
    .spec-highlights li + li { padding-left: 0; border-left: 0; border-top: 1px solid var(--s-rule); }
    .spec-highlights li { padding-right: 0; padding-bottom: 20px; }
    .sheet-cell,
    .sheet-cell--role,
    .sheet-cell--stack { grid-column: 1 / -1; border-left: 0 !important; padding-left: 0 !important; }
    .sheet-cell + .sheet-cell { border-top: 1px solid var(--s-rule); }
    .spec-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pin { width: 22px; height: 22px; margin: -11px 0 0 -11px; font-size: 0.6875rem; }
  }
</style>

<script>
  // Hovering a callout lights its pin on the screenshot.
  document.querySelectorAll<HTMLElement>('.spec').forEach((spec) => {
    const pins = spec.querySelectorAll<HTMLElement>('.spec-main .pin');
    spec.querySelectorAll<HTMLElement>('[data-callout]').forEach((item) => {
      const pin = pins[Number(item.dataset.callout) - 1];
      if (!pin) return;
      item.addEventListener('pointerenter', () => pin.setAttribute('data-lit', ''));
      item.addEventListener('pointerleave', () => pin.removeAttribute('data-lit'));
    });
  });
</script>
