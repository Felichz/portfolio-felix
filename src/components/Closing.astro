---
import Icon from './Icon.astro';

const toolset = [
  { group: 'Every day', items: 'React, TypeScript, CSS, design systems, accessibility, performance' },
  { group: 'Also shipped with', items: 'Astro, Svelte 5, Vite, Radix UI, Tailwind, Motion, SVG data visualization' },
  { group: 'Testing', items: 'Jest, Testing Library, Playwright, Cypress, axe-core' },
  { group: 'Server side', items: 'Node, WebSockets, Python and FastAPI, React on Ruby on Rails backends' },
  { group: 'AI in the loop', items: 'Claude Code, Codex, Cursor, agent skills and review pipelines, streaming LLM output' },
];
---

<section id="about" class="closing" aria-labelledby="about-title">
  <div class="wrap closing-grid">
    <div class="about">
      <h2 id="about-title" class="t-section">How I got here</h2>
      <div class="prose about-copy">
        <p class="t-lede">
          I found Scratch at 8 or 9 and fell in love with it. Before high school I ran a website of flash games packaged for the
          offline laptops kids used at school, and it got more than 300,000 page views from other children. Later I made the
          national top ten of ANIMATE, Uruguay’s animation contest, two years in a row.
        </p>
        <p class="muted">
          I still care most about the same thing: interfaces people can trust. Complex UIs and performance work are what I enjoy
          most. Agents are part of how I build now; I own the product thinking, design direction, architecture and review.
        </p>
      </div>
      <dl class="toolset">
        {
          toolset.map((t) => (
            <div>
              <dt class="t-label">{t.group}</dt>
              <dd>{t.items}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <aside id="contact" class="contact" aria-labelledby="contact-title">
      <h2 id="contact-title" class="contact-title">Hiring for a senior frontend role? I’d like to hear about it.</h2>
      <div class="contact-mail">
        <a class="contact-address" href="mailto:andersson.fx@gmail.com">andersson.fx@gmail.com</a>
        <button class="btn contact-copy" type="button" data-copy="andersson.fx@gmail.com">
          <Icon name="copy" />
          <span data-copy-label>Copy</span>
        </button>
      </div>
      <ul class="contact-links">
        <li><a class="arrow-link" href="https://www.linkedin.com/in/felixandersson/" target="_blank" rel="noopener">LinkedIn <Icon name="arrow-up-right" /></a></li>
        <li><a class="arrow-link" href="https://github.com/Felichz" target="_blank" rel="noopener">GitHub <Icon name="arrow-up-right" /></a></li>
        <li><a class="arrow-link" href="/felix-andersson-resume.pdf" target="_blank" rel="noopener">Résumé, PDF <Icon name="arrow-up-right" /></a></li>
      </ul>
    </aside>
  </div>

  <footer class="wrap colophon">
    <p>
      <strong>Colophon.</strong> Set in Archivo, across its widths; each product name is set in that product’s own typeface.
      Built with Astro and TypeScript. Screenshots captured from the live apps in September 2026 and follow your theme where the
      product has one.
    </p>
    <p class="t-num">© 2026 Felix Andersson</p>
  </footer>
</section>

<style>
  .closing { padding-top: var(--section-y); border-top: 1px solid var(--rule); }
  .closing-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 48px clamp(40px, 6vw, 110px);
    align-items: start;
  }
  .about { display: grid; gap: 28px; }
  .about-copy .t-lede { color: var(--ink); }
  .toolset { border-top: 1px solid var(--ink); }
  .toolset > div {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 16px;
    padding-block: 12px;
    border-bottom: 1px solid var(--rule);
  }
  .toolset dt { padding-top: 2px; }
  .toolset dd { font-weight: 520; font-size: 0.975rem; }

  .contact {
    position: sticky;
    top: 88px;
    display: grid;
    gap: 24px;
    padding: clamp(24px, 3vw, 40px);
    border-radius: 16px;
    background: var(--ink);
    color: var(--paper);
  }
  .contact-title {
    font-size: clamp(1.625rem, 1.1rem + 1.4vw, 2.375rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 760;
    font-stretch: 94%;
  }
  .contact-mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    padding-block: 20px;
    border-block: 1px solid color-mix(in srgb, var(--paper) 18%, transparent);
  }
  .contact-address {
    font-size: clamp(1.25rem, 0.9rem + 1.2vw, 1.875rem);
    font-weight: 700;
    font-stretch: 100%;
    letter-spacing: -0.02em;
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0% 1.5px no-repeat;
    padding-bottom: 4px;
    transition: background-size 0.45s var(--ease-out);
  }
  .contact-address:hover { background-size: 100% 1.5px; }
  .contact-copy { --b-ink: var(--paper); --b-line: color-mix(in srgb, var(--paper) 30%, transparent); min-height: 44px; padding: 0 16px; }
  .contact-copy:hover { --b-line: var(--paper); }
  .contact-links { display: flex; flex-wrap: wrap; gap: 12px 26px; }
  .contact :focus-visible { outline-color: var(--paper); }

  .colophon {
    margin-top: clamp(72px, 8vw, 120px);
    padding-top: 20px;
    padding-bottom: 40px;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 40px;
    color: var(--ink-2);
    font-size: 0.875rem;
  }
  .colophon p:first-child { max-width: 90ch; }
  .colophon strong { color: var(--ink); font-weight: 650; }

  @media (max-width: 900px) {
    .closing-grid { grid-template-columns: minmax(0, 1fr); }
    .contact { position: static; }
    .toolset > div { grid-template-columns: minmax(0, 1fr); gap: 2px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-copy-label]');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        if (label) label.textContent = 'Copied';
      } catch {
        // No clipboard access: select the address so a copy shortcut works.
        const address = document.querySelector('.contact-address');
        if (address) getSelection()?.selectAllChildren(address);
        if (label) label.textContent = 'Selected';
      }
      setTimeout(() => label && (label.textContent = 'Copy'), 2000);
    });
  });
</script>
