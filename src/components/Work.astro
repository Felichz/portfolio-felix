---
import Icon from './Icon.astro';
import Plate from './Plate.astro';
import { projects, type Project } from '../data/projects';

const accent = (p: Project) =>
  `--a-light:${p.accent.light};--a-dark:${p.accent.dark};--on-light:${p.accent.onLight};--on-dark:${p.accent.onDark}`;
const host = (url: string) => new URL(url).host;
const total = String(projects.length).padStart(2, '0');
---

<section id="work" class="panel" data-label="Work" tabindex="-1" aria-labelledby="work-title" data-accent style={accent(projects[0]!)} data-work>
  <div class="panel-inner work">
    <aside class="rail glass" data-reveal style="--d:0">
      <header class="rail-head">
        <h2 id="work-title" class="rail-title">Selected work</h2>
        <p class="rail-sub muted">A few products of my own, built recently. Each one designed and built end to end, from a written brief and its own design system.</p>
      </header>

      <ol class="rail-list" aria-label="Products">
        {
          projects.map((p, i) => (
            <li data-accent style={accent(p)}>
              <button type="button" class="rail-item spot" data-go={i} aria-current={i === 0 ? 'true' : undefined} aria-controls="work-show">
                <span class="rail-num t-num">{String(i + 1).padStart(2, '0')}</span>
                <span class={`rail-name ${p.face}`}>
                  {p.wordmark ? (
                    <>
                      <b>{p.wordmark[0]}</b>
                      {p.wordmark[1]}
                    </>
                  ) : (
                    p.name
                  )}
                </span>
                <span class="rail-short">{p.short}</span>
                <span class="rail-progress" aria-hidden="true"><i /></span>
              </button>
            </li>
          ))
        }
      </ol>

      <footer class="rail-foot">
        <button class="auto" type="button" data-auto aria-pressed="true">
          <span class="auto-icon" aria-hidden="true"><Icon name="pause" class="auto-on" /><Icon name="play" class="auto-off" /></span>
          <span class="auto-on">Auto-advancing</span>
          <span class="auto-off">Auto-advance paused</span>
        </button>
        <p class="t-label t-num rail-pos" aria-hidden="true"><span data-pos>01</span> / {total}</p>
      </footer>
    </aside>

    <div class="show" id="work-show" data-show aria-live="polite" data-reveal style="--d:1">
      {
        projects.map((p, i) => (
          <article
            class="slide"
            data-slide
            data-id={p.id}
            data-accent
            data-state={i === 0 ? 'active' : 'after'}
            style={`${accent(p)};--vt-shot:shot-${p.id};--vt-name:name-${p.id}`}
            aria-label={`${i + 1} of ${projects.length}: ${p.name}`}
            aria-hidden={i === 0 ? undefined : 'true'}
            inert={i === 0 ? undefined : true}
          >
            <a class="slide-media" href={`/work/${p.id}/`} tabindex="-1" aria-hidden="true" data-tilt="5">
              <Plate
                shot={p.main}
                chrome={host(p.live)}
                zoom={false}
                motion="manual"
                eager={i === 0}
                sizes="(min-width: 1400px) 900px, (min-width: 761px) 62vw, 92vw"
                widths={[560, 900, 1200, 1800]}
              />
            </a>
            <div class="slide-info">
              <div class="slide-head">
                <h3 class={`slide-name ${p.face}`}>
                  <a href={`/work/${p.id}/`}>
                    {p.wordmark ? (
                      <>
                        <b>{p.wordmark[0]}</b>
                        {p.wordmark[1]}
                      </>
                    ) : (
                      p.name
                    )}
                  </a>
                </h3>
                <p class="slide-tagline">{p.tagline}</p>
              </div>
              <div class="slide-side">
                <ul class="slide-points">
                  {p.highlights.map((h) => (
                    <li>{h.title}</li>
                  ))}
                </ul>
                <div class="slide-actions">
                  <a class="btn btn--solid btn--sm" href={`/work/${p.id}/`} data-link="case">
                    Case study
                    <Icon name="arrow-right" class="icon-right" />
                  </a>
                  <a class="arrow-link" href={p.live} target="_blank" rel="noopener" data-link="live">
                    Live <Icon name="arrow-up-right" />
                  </a>
                  <a class="arrow-link" href={p.source} target="_blank" rel="noopener" data-link="source">
                    Source <Icon name="arrow-up-right" />
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <!-- A deep link like #work/lifeui opens on that product before the first paint. -->
  <script is:inline>
    (() => {
      const [panel, sub] = decodeURIComponent(location.hash.slice(1)).split('/');
      if (panel !== 'work' || !sub) return;
      const root = document.querySelector('[data-work]');
      const slides = [...root.querySelectorAll('[data-slide]')];
      const i = slides.findIndex((s) => s.dataset.id === sub);
      if (i <= 0) return;
      slides.forEach((s, j) => {
        s.dataset.state = j === i ? 'active' : j < i ? 'before' : 'after';
        s.toggleAttribute('inert', j !== i);
        j === i ? s.removeAttribute('aria-hidden') : s.setAttribute('aria-hidden', 'true');
      });
      root.querySelectorAll('[data-go]').forEach((b, j) => (j === i ? b.setAttribute('aria-current', 'true') : b.removeAttribute('aria-current')));
      root.dataset.start = String(i);
    })();
  </script>
</section>

<style>
  .work {
    --rail: clamp(260px, 22cqw, 330px);
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: clamp(16px, 2.4cqw, 40px);
  }

  /* ---- Rail ---- */
  .rail {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    min-height: 0;
    padding: clamp(14px, 2.2cqh, 22px);
  }
  .rail-head { display: grid; gap: 8px; padding: 4px 6px clamp(10px, 1.8cqh, 18px); border-bottom: 1px solid var(--line); }
  .rail-title { font-size: clamp(1.5rem, 1.1rem + 1vw, 2.125rem); line-height: 1; letter-spacing: -0.035em; font-weight: 790; font-stretch: 96%; }
  .rail-sub { font-size: 0.8125rem; line-height: 1.45; }
  .rail-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-height: 0;
    padding-block: 10px;
    overflow-y: auto;
    scrollbar-width: none;
  }
  .rail-list > li { flex: 1 1 0; max-height: 104px; min-height: 0; display: flex; }
  .rail-item {
    --spot: var(--accent);
    position: relative;
    display: grid;
    align-content: center;
    grid-template-columns: 2.1em minmax(0, 1fr);
    grid-template-areas: 'num name' '. short';
    align-items: baseline;
    gap: 2px 6px;
    width: 100%;
    padding: clamp(8px, 1.4cqh, 13px) 12px clamp(10px, 1.6cqh, 15px);
    border: 0;
    border-radius: 14px;
    background: transparent;
    text-align: left;
    color: var(--ink-3);
    overflow: hidden;
    isolation: isolate;
    transition: background-color 0.4s var(--ease-out), color 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }
  .rail-item:hover { color: var(--ink-2); }
  .rail-item[aria-current='true'] {
    color: var(--ink);
    background: var(--surface-strong);
    box-shadow: inset 0 1px 0 var(--hi), 0 0 0 1px var(--line), var(--shadow-sm);
  }
  .rail-num { grid-area: num; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.02em; transition: color 0.4s; }
  .rail-item[aria-current='true'] .rail-num { color: var(--accent); }
  .rail-name { grid-area: name; font-size: clamp(1.125rem, 0.9rem + 0.6vw, 1.4rem); line-height: 1.15; letter-spacing: -0.02em; }
  .rail-name.face-martian { font-size: 1rem; letter-spacing: 0; }
  .rail-name.face-martian b { font-weight: 700; }
  .rail-short {
    grid-area: short;
    font-size: 0.8125rem;
    line-height: 1.35;
    font-weight: 500;
    color: var(--ink-3);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.4s;
  }
  .rail-item[aria-current='true'] .rail-short { color: var(--ink-2); }
  /* The countdown fills the whole item from left to right, behind the text, in the product's
     color, with a brighter leading edge. */
  .rail-progress {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.4s;
  }
  .rail-progress i {
    position: absolute;
    inset: 0;
    right: calc((1 - var(--p, 0)) * 100%);
    background: linear-gradient(90deg, color-mix(in oklab, var(--accent) 3%, transparent), color-mix(in oklab, var(--accent) 17%, transparent));
    box-shadow: inset -2px 0 0 color-mix(in oklab, var(--accent) 50%, transparent);
  }
  .rail-item[aria-current='true'] .rail-progress { opacity: 1; }

  .rail-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 4px 0;
    border-top: 1px solid var(--line);
  }
  .auto {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 36px;
    padding: 0 12px 0 4px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink-2);
    font-size: 0.8125rem;
    font-weight: 620;
    font-stretch: 92%;
    transition: color 0.2s, background-color 0.2s;
  }
  .auto:hover { color: var(--ink); background: color-mix(in oklab, var(--ink) 5%, transparent); }
  .auto-icon { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--ink); color: var(--bg); }
  .auto-icon :global(.icon) { width: 12px; height: 12px; stroke-width: 2.4; }
  .auto[aria-pressed='true'] :global(.auto-off),
  .auto[aria-pressed='false'] :global(.auto-on) { display: none; }
  .rail-pos { color: var(--ink-3); }

  /* ---- Showcase ---- */
  .show { position: relative; display: grid; min-height: 0; container: show / size; }
  .slide {
    --info: clamp(150px, 24cqh, 200px);
    grid-area: 1 / 1;
    align-self: center;
    justify-self: center;
    display: grid;
    gap: clamp(14px, 2.6cqh, 26px);
    width: min(100cqw, calc((100cqh - var(--info) - 58px) * 1.6));
    visibility: hidden;
    transition: visibility 0s linear 0.7s;
  }
  .slide[data-state='active'] { visibility: visible; transition-delay: 0s; z-index: 1; }

  .slide-media {
    position: relative;
    display: block;
    border-radius: var(--radius);
    opacity: 0;
    transform: translateX(var(--from, 4%)) scale(0.98);
    transform-origin: 50% 60%;
    transition: opacity 0.6s var(--ease-out), transform 0.9s var(--ease-out);
  }
  .slide[data-state='before'] { --from: -4%; }
  .slide[data-state='active'] .slide-media { opacity: 1; transform: none; transition-delay: 0.08s; }
  .slide[data-state='active'] .slide-media :global(.plate) { view-transition-name: var(--vt-shot); }
  /* The product's color glows behind its window, and pools on the floor under it. */
  .slide-media::before {
    content: '';
    position: absolute;
    inset: 8% 6% -6%;
    z-index: -1;
    border-radius: 40%;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--accent) 34%, transparent), transparent);
    opacity: 0.75;
  }
  /* The window leans toward the pointer, with a light sheen that follows it. */
  .slide-media :global(.plate) {
    transform: perspective(1600px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.7s var(--ease-out), box-shadow 0.6s var(--ease-out);
  }
  .slide-media:hover :global(.plate) { transform: perspective(1600px) translateY(-4px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); }
  .slide-media[data-tilting] :global(.plate) { transition: transform 0.15s linear, box-shadow 0.6s var(--ease-out); }
  /* On the window itself, so it moves with the lean and the lift. */
  .slide-media :global(.plate)::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    background: radial-gradient(45% 55% at var(--sx, 50%) var(--sy, 0%), rgb(255 255 255 / 0.12), transparent 65%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s var(--ease-out);
  }
  .slide-media[data-tilting] :global(.plate)::after { opacity: 1; }

  .slide-info {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 16px clamp(20px, 3cqw, 44px);
    min-height: var(--info);
    align-content: start;
  }
  .slide-head, .slide-side { display: grid; gap: 10px; align-content: start; }
  .slide-head > *, .slide-side > * {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s var(--ease-out), transform 0.7s var(--ease-out);
  }
  .slide[data-state='active'] :is(.slide-head, .slide-side) > * { opacity: 1; transform: none; }
  .slide[data-state='active'] .slide-head > :nth-child(1) { transition-delay: 0.16s; }
  .slide[data-state='active'] .slide-head > :nth-child(2) { transition-delay: 0.24s; }
  .slide[data-state='active'] .slide-side > :nth-child(1) { transition-delay: 0.3s; }
  .slide[data-state='active'] .slide-side > :nth-child(2) { transition-delay: 0.38s; }

  .slide-name {
    font-size: clamp(2rem, min(4cqw, 7cqh), 3.5rem);
    line-height: 1;
    font-weight: inherit;
    letter-spacing: -0.035em;
  }
  .slide[data-state='active'] .slide-name { view-transition-name: var(--vt-name); }
  .slide-name a { text-decoration: none; }
  .slide-name.face-martian { font-size: clamp(1.5rem, min(3cqw, 5.4cqh), 2.6rem); letter-spacing: -0.02em; font-weight: 400; }
  .slide-name.face-martian b { font-weight: 700; }
  .slide-name.face-inter { letter-spacing: -0.045em; }
  .slide-tagline { font-size: 0.975rem; line-height: 1.5; color: var(--ink-2); max-width: 48ch; }
  .slide-points { display: grid; gap: 5px; }
  .slide-points li {
    position: relative;
    padding-left: 20px;
    font-size: 0.9375rem;
    font-weight: 580;
    font-stretch: 94%;
    line-height: 1.35;
  }
  .slide-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.34em;
    width: 11px;
    height: 11px;
    border-radius: 4px;
    background: color-mix(in oklab, var(--accent) 22%, transparent);
    box-shadow: inset 0 0 0 1.5px var(--accent);
  }
  .slide-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; margin-top: 4px; }

  @media (prefers-reduced-motion: reduce) {
    .slide-media, .slide-head > *, .slide-side > * { transform: none !important; transition-property: opacity; transition-duration: 0.2s; }
  }

  /* Wide but short windows: the story sits beside the screenshot. */
  @container show (min-aspect-ratio: 3 / 2) {
    .slide {
      --info: 0px;
      grid-template-columns: minmax(0, 1fr) clamp(240px, 26cqw, 340px);
      align-items: center;
      width: min(100cqw, calc((100cqh - 40px) * 1.6 + clamp(240px, 26cqw, 340px) + 32px));
    }
    .slide-info { grid-template-columns: minmax(0, 1fr); gap: 22px; }
    .slide-name { font-size: clamp(2rem, min(3.4cqw, 8cqh), 3.75rem); }
  }

  /* Phones: product chips on top, one product at a time below, scrolling inside the panel. */
  @container panel (max-width: 760px) {
    .work { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto; gap: 16px; height: auto; }
    .rail { padding: 0; background: none; box-shadow: none; -webkit-backdrop-filter: none; backdrop-filter: none; grid-template-rows: auto auto; }
    .rail-head { padding: 0 0 12px; border: 0; }
    .rail-foot { display: none; }
    .rail-list {
      flex-direction: row;
      justify-content: flex-start;
      gap: 6px;
      padding: 2px;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
    }
    .rail-list > li { flex: none; max-height: none; }
    .rail-item {
      grid-template-columns: auto;
      grid-template-areas: 'name';
      width: auto;
      padding: 8px 14px 10px;
      border-radius: 999px;
      box-shadow: 0 0 0 1px var(--line);
      white-space: nowrap;
    }
    .rail-num, .rail-short { display: none; }
    .rail-name { font-size: 1rem; }
    .rail-name.face-martian { font-size: 0.8125rem; }
    .show { container-type: normal; }
    .slide { width: 100%; align-self: start; }
    .slide-info { grid-template-columns: minmax(0, 1fr); min-height: 0; }
    .slide-name { font-size: 2.25rem; }
    .slide-name.face-martian { font-size: 1.625rem; }
  }
</style>

<script>
  import { editions, followThemeSwitches } from '../scripts/handoff';

  const root = document.querySelector<HTMLElement>('[data-work]');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const items = [...root.querySelectorAll<HTMLButtonElement>('[data-go]')];
    const show = root.querySelector<HTMLElement>('[data-show]')!;
    const autoBtn = root.querySelector<HTMLButtonElement>('[data-auto]')!;
    const pos = root.querySelector<HTMLElement>('[data-pos]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const HOLD = 3200; // time on the final still after a recording ends
    const STILL = 8500; // time per product without a recording

    let index = Number(root.dataset.start ?? 0);
    let auto = !reduce.matches;
    let hold = false;
    let liveHold = false;
    let active = root.hasAttribute('data-active');
    let elapsed = 0;
    let total = STILL;
    let last = performance.now();
    let raf = 0;

    const plateOf = (i: number) => slides[i]?.querySelector<HTMLElement>('.plate') ?? null;
    const clipOf = (i: number) => {
      const plate = plateOf(i);
      return plate ? editions(plate).from : undefined;
    };

    const rest = (i: number) => {
      const plate = plateOf(i);
      if (!plate) return;
      if (plate.dataset.state) plate.dataset.state = 'idle';
      const v = plate.querySelectorAll<HTMLVideoElement>('video, tape-player');
      setTimeout(() => v.forEach((x) => (x.pause(), (x.currentTime = 0))), 500);
    };

    const roll = () => {
      const plate = plateOf(index);
      const v = clipOf(index);
      total = STILL;
      if (!plate || !v || reduce.matches || !active) return;
      const setTotal = () => {
        if (Number.isFinite(v.duration)) total = v.duration * 1000 + HOLD;
      };
      if (v.readyState >= 1) setTotal();
      else v.addEventListener('loadedmetadata', setTotal, { once: true });
      v.preload = 'auto';
      v.currentTime = 0;
      plate.dataset.state = 'loading';
      v.addEventListener('playing', () => plate.dataset.state === 'loading' && (plate.dataset.state = 'playing'), { once: true });
      v.onended = () => (plate.dataset.state = 'done');
      v.play().catch(() => (plate.dataset.state = 'idle'));
    };

    const paint = () => {
      items[index]?.style.setProperty('--p', String(Math.min(1, elapsed / total)));
    };

    const select = (i: number, from: 'auto' | 'user' = 'user') => {
      const n = slides.length;
      const j = ((i % n) + n) % n;
      if (j === index && from === 'auto') return;
      const prev = index;
      index = j;
      slides.forEach((s, k) => {
        s.dataset.state = k === j ? 'active' : k < j ? 'before' : 'after';
        s.toggleAttribute('inert', k !== j);
        k === j ? s.removeAttribute('aria-hidden') : s.setAttribute('aria-hidden', 'true');
      });
      items.forEach((b, k) => {
        k === j ? b.setAttribute('aria-current', 'true') : b.removeAttribute('aria-current');
        b.style.setProperty('--p', '0');
      });
      if (pos) pos.textContent = String(j + 1).padStart(2, '0');
      // The whole panel takes on the product's accent, and the room light follows.
      const s = slides[j]!;
      for (const k of ['--a-light', '--a-dark', '--on-light', '--on-dark']) root.style.setProperty(k, s.style.getPropertyValue(k));
      document.dispatchEvent(new CustomEvent('deck:refresh'));
      if (prev !== j) rest(prev);
      elapsed = 0;
      roll();
      if (active) history.replaceState(history.state, '', `#work/${s.dataset.id}`);
      // Keep the chosen chip in view on phones, scrolling only the strip.
      const li = items[j]?.parentElement;
      const strip = li?.parentElement;
      if (li && strip && strip.scrollWidth > strip.clientWidth) {
        strip.scrollTo({ left: li.offsetLeft - strip.clientWidth / 2 + li.offsetWidth / 2, behavior: reduce.matches ? 'instant' : 'smooth' });
      }
    };

    const loop = (now: number) => {
      const dt = Math.min(100, now - last);
      last = now;
      if (auto && active && !hold && !liveHold && !document.hidden) {
        elapsed += dt;
        if (elapsed >= total) select(index + 1, 'auto');
      }
      paint();
      raf = requestAnimationFrame(loop);
    };
    const run = () => {
      cancelAnimationFrame(raf);
      last = performance.now();
      raf = requestAnimationFrame(loop);
    };

    const setAuto = (on: boolean) => {
      auto = on;
      autoBtn.setAttribute('aria-pressed', String(on));
      // Announce product changes only when the visitor is driving, never on every automatic turn.
      show.setAttribute('aria-live', on ? 'off' : 'polite');
    };

    items.forEach((b, i) => b.addEventListener('click', () => select(i)));
    // Up and down move through the list, like a menu.
    root.querySelector('.rail-list')?.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      const step = ev.key === 'ArrowDown' ? 1 : ev.key === 'ArrowUp' ? -1 : 0;
      if (!step) return;
      ev.preventDefault();
      const j = Math.max(0, Math.min(items.length - 1, index + step));
      items[j]?.focus();
      select(j);
    });
    autoBtn.addEventListener('click', () => {
      setAuto(!auto);
      if (auto && elapsed >= total) select(index + 1, 'auto');
    });

    // Reading a product's text pauses the countdown; watching its recording doesn't need to.
    show.addEventListener('pointerover', (e) => {
      if (e.pointerType === 'mouse') hold = !!(e.target as HTMLElement).closest('.slide-info');
    });
    show.addEventListener('pointerleave', () => (hold = false));
    show.addEventListener('focusin', () => (hold = true));
    show.addEventListener('focusout', (e) => !show.contains(e.relatedTarget as Node) && (hold = false));

    document.addEventListener('deck:change', (e) => {
      const was = active;
      active = (e as CustomEvent).detail.id === 'work';
      if (active && !was) {
        const plate = plateOf(index);
        if (!plate?.dataset.state || plate.dataset.state === 'idle') {
          elapsed = 0;
          roll();
        }
        run();
      } else if (!active && was) {
        clipOf(index)?.pause();
        cancelAnimationFrame(raf);
      }
    });
    document.addEventListener('deck:sub', (e) => {
      const { id, sub } = (e as CustomEvent).detail;
      if (id !== 'work') return;
      const j = slides.findIndex((s) => s.dataset.id === sub);
      if (j >= 0) select(j);
    });
    // A live preview being used (hovered) holds the countdown (src/scripts/live.ts).
    document.addEventListener('live:hold', (e) => (liveHold = (e as CustomEvent<boolean>).detail));
    // An app opened in its window holds the showcase until it closes.
    document.addEventListener('thaw:open', () => {
      if (!active) return;
      cancelAnimationFrame(raf);
    });
    document.addEventListener('thaw:close', () => {
      if (!active) return;
      const v = clipOf(index);
      const plate = plateOf(index);
      // A live preview stays live; only a tape or a video picks up again.
      if (v && plate?.dataset.state === 'playing' && !plate.hasAttribute('data-live')) void v.play();
      run();
    });

    // A theme switch hands the recording to the other edition's video on the same frame; the countdown
    // doesn't notice.
    followThemeSwitches(
      () => (plateOf(index) && active ? [plateOf(index)!] : []),
      (plate, to) => {
        to.onended = () => (plate.dataset.state = 'done');
        if (plate.dataset.state === 'loading') to.addEventListener('playing', () => plate.dataset.state === 'loading' && (plate.dataset.state = 'playing'), { once: true });
      },
    );

    setAuto(auto);
    index = -1;
    select(Number(root.dataset.start ?? 0));
    if (active) run();
  }
</script>
