---
import Icon from './Icon.astro';
import type { PanelLink } from './Bar.astro';

interface Props {
  panels: PanelLink[];
}

const { panels } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<!-- The section rail: dots on a line down the left edge (desktop), a tab bar at the bottom (phones). -->
<nav class="dock" aria-label="Sections" data-dock>
  <ol class="rail-dots">
    {
      panels.map((p, i) => (
        <li>
          <a href={`#${p.id}`} data-tab={p.id} aria-current={i === 0 ? 'true' : undefined}>
            <span class="dot" aria-hidden="true" />
            <span class="dot-label">
              <span class="t-num">{pad(i + 1)}</span> {p.label}
            </span>
          </a>
        </li>
      ))
    }
  </ol>

  <ul class="tabbar">
    {
      panels.map((p, i) => (
        <li>
          <a href={`#${p.id}`} data-tab={p.id} aria-current={i === 0 ? 'true' : undefined}>
            <Icon name={p.icon} />
            <span>{p.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .dock {
    position: relative;
    z-index: 20;
    display: grid;
    place-items: center;
  }

  /* ---- Desktop: a vertical line with one dot per section ---- */
  .rail-dots {
    position: relative;
    display: grid;
    gap: clamp(18px, 4vh, 34px);
    padding-block: 6px;
  }
  .rail-dots::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(transparent, var(--line-2) 12%, var(--line-2) 88%, transparent);
  }
  .rail-dots a {
    position: relative;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    text-decoration: none;
    border-radius: 50%;
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 0 0 0 1.5px var(--ink-3);
    transition: transform 0.3s var(--ease-out), background-color 0.3s, box-shadow 0.3s;
  }
  .rail-dots a:hover .dot { transform: scale(1.25); box-shadow: 0 0 0 1.5px var(--ink); }
  .rail-dots a[aria-current='true'] .dot {
    background: var(--ink);
    box-shadow: 0 0 0 1.5px var(--ink), 0 0 0 5px color-mix(in oklab, var(--glow) 28%, transparent);
    transform: scale(1.15);
  }
  /* The label sits beside its dot: always for the current section, on hover or focus for the rest. */
  .dot-label {
    position: absolute;
    left: calc(100% + 6px);
    top: 50%;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--surface-strong);
    box-shadow: 0 0 0 1px var(--line), var(--shadow-sm);
    font-size: 0.75rem;
    font-weight: 650;
    font-stretch: 90%;
    color: var(--ink-2);
    white-space: nowrap;
    opacity: 0;
    transform: translate(-4px, -50%);
    pointer-events: none;
    transition: opacity 0.25s var(--ease-out), transform 0.3s var(--ease-out);
  }
  .dot-label .t-num { color: var(--ink-3); margin-right: 2px; }
  .rail-dots a:hover .dot-label,
  .rail-dots a:focus-visible .dot-label { opacity: 1; transform: translate(0, -50%); }

  .tabbar { display: none; }

  /* ---- Phones: a tab bar ---- */
  @media (max-width: 760px) {
    .dock { display: block; place-items: normal; padding: 0 8px env(safe-area-inset-bottom); border-top: 1px solid var(--line); background: var(--bg); }
    .rail-dots { display: none; }
    .tabbar { display: flex; height: 100%; }
    .tabbar li { flex: 1 1 0; min-width: 0; }
    .tabbar a {
      position: relative;
      display: grid;
      place-items: center;
      align-content: center;
      gap: 3px;
      height: 100%;
      font-size: 0.6875rem;
      font-weight: 620;
      font-stretch: 90%;
      color: var(--ink-3);
      text-decoration: none;
    }
    .tabbar a span { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tabbar :global(.icon) { width: 20px; height: 20px; }
    .tabbar a[aria-current='true'] { color: var(--ink); }
    .tabbar a::before {
      content: '';
      position: absolute;
      top: -1px;
      left: 30%;
      right: 30%;
      height: 2px;
      border-radius: 0 0 2px 2px;
      background: var(--ink);
      transform: scaleX(0);
      transition: transform 0.4s var(--ease-out);
    }
    .tabbar a[aria-current='true']::before { transform: scaleX(1); }
  }
</style>
