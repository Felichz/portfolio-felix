---
import MainThread from './MainThread.astro';
import Pipeline from './Pipeline.astro';

// Chronological, left to right.
const roles = [
  {
    when: '2020 to 2021',
    title: 'Frontend Engineer',
    org: 'Device Magic',
    body: 'Owned the whole web frontend after the senior developer left and carried it to the MVP launch: a dynamic forms engine with unlimited nested groups and real-time expressions, made orders of magnitude faster on large forms.',
  },
  {
    when: '2021 to 2022',
    title: 'Design system',
    org: 'Cisco Magnetic',
    body: 'Joined Magnetic in its early stages, building reusable React components with accessibility and performance as the bar, from detailed design specs to the first production release.',
  },
  {
    when: '2022 to 2023',
    title: 'Meraki Dashboard',
    org: 'Cisco Meraki',
    body: 'Built the most used data pages (Access Points, Switches, Clients): tables with filtering, sorting and export for customers with 100k+ rows. Broke critical features down so several people could build in parallel.',
  },
  {
    when: '2023 to now',
    title: 'Component library',
    org: 'Cisco Magnetic',
    body: 'I maintain the React and TypeScript library Meraki teams build on: data table features to detailed specs, support for hundreds of adopting developers, review standards and the team’s AI review tooling.',
  },
];
---

<section id="experience" class="exp" aria-labelledby="exp-title">
  <div class="wrap">
    <header class="exp-head">
      <h2 id="exp-title" class="t-section">Five years inside Cisco’s design system</h2>
      <p class="t-lede muted">
        Through Vairix, I’ve worked on Magnetic, the design system behind the Meraki Dashboard, since its first components. When
        the thing you own is every team’s dependency, you care a lot about UX and technical quality.
      </p>
    </header>

    <ol class="timeline">
      {
        roles.map((r, i) => (
          <li class:list={['stop', i === roles.length - 1 && 'stop--now']}>
            <p class="t-label t-num">{r.when}</p>
            <h3 class="stop-title">
              {r.title}
              <span class="stop-org">{r.org}</span>
            </h3>
            <p class="stop-body">{r.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="exhibits">
      <article class="exhibit" id="rows">
        <h3 class="t-sub">100,000 rows without freezing the page</h3>
        <p class="exhibit-lede muted">
          Big Meraki customers have tables with more than 100,000 rows. A filter that runs as one long task freezes typing and
          painting on every keystroke. I split it into short slices that yield to the browser and render matches the moment
          they exist, so the table stays at 60&nbsp;FPS while you type.
        </p>
        <div class="exhibit-plate">
          <MainThread />
        </div>
        <p class="t-label">Schematic, not a measurement.</p>
      </article>

      <article class="exhibit" id="ai-review">
        <h3 class="t-sub">Raising the review bar when AI arrived</h3>
        <p class="exhibit-lede muted">
          When AI adoption became a top goal for every team, I spent two to three months building tooling that raised our review
          bar instead of letting quality slip. The team still runs it on every push.
        </p>
        <div class="exhibit-plate">
          <Pipeline />
        </div>
        <details class="story">
          <summary>How I built it</summary>
          <div class="story-body prose muted">
            <p>
              Breaking changes had been a pain for years. One nobody noticed could silently break types, tests and behavior in
              consumer apps, and some had forced hotfixes and reverts to unblock releases. Before writing the scanner I mined the
              repo history (every hotfix PR, every revert, every incident), worked out the root causes, and designed it to catch
              each case I found.
            </p>
            <p>
              For code review I pulled thousands of our GitLab review comments, used LLMs to find the ones that caught real bugs
              or improved maintainability, and distilled the top 100+ into calibration examples for five specialized reviewers.
              Alongside it went an AGENTS.md for the repo and five coding skills with explicit boundaries, from implementation
              guardrails to deprecation patterns.
            </p>
            <p>The team lead said it was exactly what the team needed, and key to opening the repo to outside contributions.</p>
          </div>
        </details>
      </article>
    </div>
  </div>
</section>

<style>
  .exp { padding-block: var(--section-y); border-top: 1px solid var(--rule); }
  .exp-head {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 24px clamp(32px, 5vw, 80px);
    align-items: end;
  }
  .exp-head p { max-width: 50ch; }

  /* ---- Horizontal timeline ---- */
  .timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(20px, 2.6vw, 40px);
    margin-top: clamp(48px, 5vw, 72px);
    padding-top: 26px;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 5px;
    height: 1px;
    background: linear-gradient(90deg, var(--rule-2), var(--ink) 92%);
  }
  .stop { position: relative; display: grid; gap: 8px; align-content: start; }
  .stop::before {
    content: '';
    position: absolute;
    top: -26px;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--rule-2);
  }
  .stop--now::before {
    background: var(--ink);
    border-color: var(--ink);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .stop-title { font-size: 1.1875rem; line-height: 1.2; font-weight: 720; font-stretch: 94%; letter-spacing: -0.01em; }
  .stop-org { display: block; margin-top: 3px; font-size: 0.875rem; font-weight: 520; color: var(--ink-2); }
  .stop-body { font-size: 0.9375rem; line-height: 1.55; color: var(--ink-2); }

  /* ---- Exhibits ---- */
  .exhibits {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 64px);
    margin-top: clamp(64px, 7vw, 104px);
  }
  .exhibit { display: grid; gap: 16px; align-content: start; }
  .exhibit-lede { max-width: 56ch; }
  .exhibit-plate {
    padding: clamp(18px, 2.4vw, 32px);
    border-radius: 14px;
    background: var(--raised);
    box-shadow: 0 0 0 1px var(--rule);
  }

  .story { border-top: 1px solid var(--rule); }
  .story summary {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-weight: 620;
    font-stretch: 92%;
    cursor: pointer;
    list-style: none;
  }
  .story summary::-webkit-details-marker { display: none; }
  .story summary::after {
    content: '';
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.3s var(--ease-out);
  }
  .story[open] summary::after { transform: translateY(1px) rotate(-135deg); }
  /* Smooth open where the browser supports animating details content. */
  .story::details-content {
    block-size: 0;
    overflow: clip;
    transition: block-size 0.4s var(--ease-out), content-visibility 0.4s allow-discrete;
  }
  .story[open]::details-content { block-size: auto; }
  .story-body { padding-bottom: 8px; font-size: 0.975rem; }

  @media (max-width: 1000px) {
    .exp-head, .exhibits { grid-template-columns: minmax(0, 1fr); }
    .timeline { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 40px; }
    .timeline::before { display: none; }
    .stop { padding-top: 22px; border-top: 1px solid var(--rule); }
    .stop::before { top: -6px; }
  }
  @media (max-width: 560px) {
    .timeline { grid-template-columns: minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .story::details-content { transition: none; }
  }
</style>
