---
import Icon from './Icon.astro';
import { experience } from '../data/career';

type Month = [year: number, month: number];

interface Role {
  id: string;
  bar: string;
  title: string;
  org: string;
  via?: string;
  start: Month;
  /** Last month in the role, inclusive. Omitted for the current role. */
  end?: Month;
  summary: string;
  points: string[];
  tags: string[];
  glance?: { k: string; v: string }[];
  /** A few concrete examples, told in prose. */
  examples?: { title: string; body: string }[];
}

// Chronological and continuous: each bar runs until the next role starts.
const roles: Role[] = [
  {
    id: 'device-magic',
    bar: 'Device Magic',
    title: 'Frontend Engineer',
    org: 'Device Magic',
    via: 'through Vairix',
    start: [2020, 12],
    end: [2021, 7],
    summary: 'My first product. I ended up owning the whole web frontend after the senior developer left, and took it to its MVP launch.',
    points: [
      'A dynamic forms engine: unlimited nested sections, recursive state and real-time expression evaluation.',
      'When the backend switched to an incompatible XML format, a client-side adapter that translated it on the fly instead of a rewrite.',
      'Large forms made orders of magnitude faster by reworking the algorithms and the rendering.',
      'The UI for a webcam barcode scanner: a focused scan area with real-time feedback.',
    ],
    tags: ['React', 'State management', 'Performance', 'Ownership'],
    glance: [
      { k: 'Outcome', v: 'MVP launch, with the frontend in my hands' },
      { k: 'Hardest part', v: 'Recursive forms that stay fast at any size' },
    ],
  },
  {
    id: 'magnetic',
    bar: 'Magnetic design system',
    title: 'Frontend Engineer, Design System',
    org: 'Cisco, Magnetic design system',
    via: 'through Vairix',
    start: [2021, 8],
    end: [2022, 7],
    summary: 'Joined Magnetic, Cisco’s design system, while it had its first components, and helped take it to its first production release.',
    points: [
      'Reusable React components with accessibility and performance as the bar, not an afterthought.',
      'Detailed design specs turned into components, working directly with the design team.',
      'Testing and QA for the library’s first production release.',
    ],
    tags: ['React', 'TypeScript', 'Accessibility', 'Design systems'],
    glance: [
      { k: 'Outcome', v: 'Magnetic’s first production release' },
      { k: 'Focus', v: 'Accessibility, performance, spec fidelity' },
    ],
  },
  {
    id: 'meraki',
    bar: 'Meraki Dashboard',
    title: 'Frontend Engineer, Product Implementation',
    org: 'Cisco Meraki, Meraki Dashboard',
    via: 'through Vairix',
    start: [2022, 8],
    end: [2023, 10],
    summary: 'Built the most used data pages of the Meraki Dashboard: Access Points, Switches and Clients.',
    points: [
      'Tables with filtering, sorting and export, optimized for the largest customers’ datasets.',
      'Planned and broke down critical features so several developers could build in parallel.',
      'Moved teams from legacy UI components to Magnetic while keeping what they had working.',
    ],
    tags: ['React', 'TypeScript', 'Data-heavy UI', 'Planning'],
    glance: [
      { k: 'Pages', v: 'Access Points, Switches, Clients' },
      { k: 'Also', v: 'Feature planning and ticket breakdown for the team' },
    ],
  },
  {
    id: 'library',
    bar: 'Magnetic component library',
    title: 'Frontend Product Engineer',
    org: 'Cisco, Magnetic component library',
    via: 'through Vairix',
    start: [2023, 11],
    summary:
      'The proactive maintainer of the React and TypeScript library that Meraki teams build on. When leadership needs something, I take it from spec to release.',
    points: [
      'Complex data table features built to detailed design specs, the most demanding components in the library.',
      'Support for the hundreds of developers who adopt the library, and the review standards that keep it stable.',
      'OKR epics leadership needed, owned from problem to release.',
      'Tools and ideas for the team beyond the tickets, like the AI stack below.',
    ],
    tags: ['React', 'TypeScript', 'Design systems', 'Accessibility', 'AI tooling'],
    examples: [
      {
        title: 'The team’s AI engineering stack',
        body: 'When leadership made AI adoption an OKR for every team, I used it to raise our quality bar instead of letting it slip. In two to three months: an AGENTS.md, coding skills with explicit boundaries, and a pre-push hook that runs a breaking-change scanner (designed from every hotfix and revert in the repo’s history) and a review orchestrator with five specialized reviewers, calibrated on 100+ comments distilled from thousands. The team still runs it on every push.',
      },
      {
        title: 'Responsive tables on large datasets',
        body: 'A table filter that froze typing on big customers’ data, split into short slices that yield to the browser, so matches render as they arrive.',
      },
      {
        title: 'What the team lead said',
        body: 'That it was exactly what the team needed, and key to opening the repo to outside contributions.',
      },
    ],
  },
];

const now = new Date();
const nowM = now.getFullYear() * 12 + now.getMonth() + now.getDate() / 31;
const m = ([y, mo]: Month) => y * 12 + (mo - 1);
const axisStart = m([2020, 11]);
const axisEnd = nowM + 3;
const at = (v: number) => ((v - axisStart) / (axisEnd - axisStart)) * 100;
const years = [2021, 2022, 2023, 2024, 2025, 2026];
const barEnd = (i: number) => (roles[i + 1] ? m(roles[i + 1]!.start) : nowM);

const monthName = (mo: number) => new Date(2000, mo - 1, 1).toLocaleString('en-US', { month: 'short' });
const when = (r: Role) => `${monthName(r.start[1])} ${r.start[0]} to ${r.end ? `${monthName(r.end[1])} ${r.end[0]}` : 'now'}`;
const span = (r: Role) => {
  const months = Math.max(1, Math.round((r.end ? m(r.end) + 1 : nowM) - m(r.start)));
  const y = Math.floor(months / 12);
  const mo = months % 12;
  return [y && `${y} yr${y > 1 ? 's' : ''}`, mo && `${mo} mo${mo > 1 ? 's' : ''}`].filter(Boolean).join(' ');
};
const exp = experience();
const current = roles.findIndex((r) => r.id === 'library');
---

<section id="experience" class="panel" data-label="Experience" tabindex="-1" aria-labelledby="exp-title" data-exp>
  <div class="panel-inner exp">
    <header class="exp-head" data-reveal style="--d:0">
      <div class="exp-title">
        <h2 id="exp-title" class="t-section">Experience</h2>
        <p class="t-lede muted">
          {exp.phrase} through Vairix, most of them at Cisco as the maintainer Meraki teams count on: shipping components to spec,
          supporting the developers who build on them, and building the tools the team needed before anyone asked.
        </p>
      </div>
      <a class="btn" href="/felix-andersson-resume.pdf" target="_blank" rel="noopener"><Icon name="download" />Résumé, PDF</a>
    </header>

    <div class="gantt glass" data-reveal style="--d:1">
      <div class="gantt-grid" aria-hidden="true">
        {years.map((y) => <span class="gantt-year" style={`--at:${at(m([y, 1]))}%`}>{y}</span>)}
        <span class="gantt-now" style={`--at:${at(nowM)}%`}><b>Now</b></span>
      </div>
      <div class="gantt-row">
        {
          roles.map((r, i) => (
            <button
              type="button"
              class="bar spot"
              style={`--x:${at(m(r.start))}%;--w:${at(barEnd(i)) - at(m(r.start))}%`}
              data-pick={i}
              aria-pressed={i === current ? 'true' : 'false'}
              aria-controls={`role-${r.id}`}
              aria-label={`${r.org}, ${when(r)}`}
            >
              <span class="bar-name">{r.bar}</span>
              <span class="bar-years t-num">{r.start[0]}–{r.end ? String(r.end[0]).slice(2) : 'now'}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="roles" data-reveal style="--d:2">
      {
        roles.map((r, i) => (
          <article
            class="role"
            id={`role-${r.id}`}
            data-role
            data-state={i === current ? 'active' : undefined}
            aria-labelledby={`role-${r.id}-title`}
          >
            <div class="role-main scroll-y">
              <p class="role-when">
                <span class="t-num">{when(r)}</span>
                <span class="role-span t-num">{span(r)}</span>
              </p>
              <h3 id={`role-${r.id}-title`} class="role-title">
                {r.title}
              </h3>
              <p class="role-org">
                {r.org}
                {r.via && <span class="muted"> · {r.via}</span>}
              </p>
              <p class="role-summary">{r.summary}</p>
              <ul class="role-points">
                {r.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
              <ul class="role-tags">
                {r.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>

            <aside class="role-card glass" aria-label="A closer look">
              {r.examples ? (
                <div class="examples scroll-y">
                  <p class="t-label">A few examples</p>
                  {r.examples.map((x) => (
                    <p class="example">
                      <b>{x.title}.</b> {x.body}
                    </p>
                  ))}
                </div>
              ) : (
                <dl class="glance">
                  {r.glance?.map((g) => (
                    <div>
                      <dt class="t-label">{g.k}</dt>
                      <dd>{g.v}</dd>
                    </div>
                  ))}
                  <div>
                    <dt class="t-label">Time on it</dt>
                    <dd class="t-num">{span(r)}</dd>
                  </div>
                </dl>
              )}
            </aside>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .exp {
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    gap: clamp(12px, 2.2cqh, 26px);
  }
  .exp-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; }
  .exp-title { display: grid; gap: 10px; }
  .exp-title p { max-width: 78ch; }

  /* ---- Gantt ---- */
  .gantt {
    position: relative;
    display: grid;
    gap: 10px;
    padding: 36px clamp(14px, 2cqw, 26px) clamp(14px, 2cqh, 20px);
  }
  .gantt-grid {
    position: absolute;
    inset: 12px clamp(14px, 2cqw, 26px) 10px;
    pointer-events: none;
  }
  .gantt-year {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--at);
    padding-left: 7px;
    border-left: 1px dashed var(--line-2);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .gantt-year--first { border-left-color: transparent; padding-left: 0; }
  .gantt-now {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--at);
    width: 0;
    border-left: 1.5px solid var(--house-2);
  }
  .gantt-now b {
    position: absolute;
    top: -2px;
    left: 0;
    transform: translateX(-50%);
    padding: 2px 7px;
    border-radius: 999px;
    background: var(--house-2);
    color: var(--on-house);
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--house-2) 20%, transparent);
  }
  .gantt-row { position: relative; height: clamp(40px, 6cqh, 52px); }

  .bar {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--x);
    width: calc(var(--w) - 4px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1px;
    min-width: 0;
    padding: 0 12px;
    border: 0;
    border-radius: 12px;
    background: var(--surface-strong);
    box-shadow: inset 0 1px 0 var(--hi), 0 0 0 1px var(--line-2);
    color: var(--ink-2);
    text-align: left;
    overflow: hidden;
    transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out), color 0.35s, background-color 0.35s;
  }
  .bar:hover { transform: translateY(-2px); color: var(--ink); box-shadow: inset 0 1px 0 var(--hi), 0 0 0 1px var(--ink), var(--shadow); }
  .bar-name { font-size: 0.8125rem; font-weight: 700; font-stretch: 88%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bar-years { font-size: 0.6875rem; font-weight: 600; opacity: 0.75; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bar[aria-pressed='true'] {
    color: var(--on-house);
    background: linear-gradient(135deg, var(--house-2), var(--house));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.25), 0 0 0 1px var(--house), 0 12px 28px -12px var(--house-2);
  }
  .bar[aria-pressed='true'] .bar-years { opacity: 0.9; }

  /* ---- Role details ---- */
  .roles { display: grid; min-height: 0; }
  .role {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    gap: clamp(16px, 3cqw, 48px);
    min-height: 0;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.45s var(--ease-out), visibility 0s linear 0.45s;
  }
  /* The incoming role rises in; hidden roles carry no offset, so they never stretch the section. */
  .role[data-state='active'] { visibility: visible; opacity: 1; transition-delay: 0s; animation: role-in 0.6s var(--ease-out); }
  @keyframes role-in {
    from { transform: translateY(10px); }
  }
  .role-main { display: flex; flex-direction: column; gap: 10px; min-height: 0; padding: 4px 8px 4px 2px; }
  .role-when { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 0.8125rem; font-weight: 650; color: var(--ink-2); }
  .role-span { padding: 2px 8px; border-radius: 999px; background: color-mix(in oklab, var(--house) 12%, transparent); color: var(--house); font-size: 0.75rem; }
  .role-title { font-size: clamp(1.375rem, 1rem + 1vw, 2rem); line-height: 1.08; letter-spacing: -0.03em; font-weight: 760; font-stretch: 94%; }
  .role-org { font-size: 0.975rem; font-weight: 620; }
  .role-summary { font-size: 1rem; color: var(--ink-2); max-width: 58ch; }
  .role-points { display: grid; gap: 7px; margin-top: 2px; }
  .role-points li { position: relative; padding-left: 18px; font-size: 0.9375rem; line-height: 1.45; max-width: 62ch; }
  .role-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 9px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--ink-3);
  }
  .role-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  .role-tags li {
    padding: 3px 10px;
    border-radius: 999px;
    box-shadow: 0 0 0 1px var(--line-2);
    font-size: 0.75rem;
    font-weight: 620;
    font-stretch: 92%;
    color: var(--ink-2);
  }

  .role-card { display: grid; min-height: 0; padding: clamp(14px, 2cqh, 22px); }
  .glance { display: grid; align-content: center; gap: 0; }
  .glance > div { display: grid; gap: 4px; padding-block: 14px; border-bottom: 1px solid var(--line); }
  .glance > div:last-child { border-bottom: 0; }
  .glance dd { font-size: clamp(1.0625rem, 0.9rem + 0.5vw, 1.375rem); font-weight: 700; font-stretch: 94%; letter-spacing: -0.015em; line-height: 1.25; }

  /* ---- Examples for the current role: prose, not diagrams ---- */
  .examples { display: grid; align-content: center; gap: 14px; min-height: 0; padding-right: 6px; }
  .example { font-size: 0.9375rem; line-height: 1.55; color: var(--ink-2); max-width: 64ch; }
  .example b { color: var(--ink); font-weight: 700; font-stretch: 94%; }
  .example:last-child { padding-top: 12px; border-top: 1px solid var(--line); font-family: var(--serif); font-style: italic; font-size: 1.0625rem; }
  .example:last-child b { font-family: var(--font); font-style: normal; font-size: 0.875rem; }

  @media (prefers-reduced-motion: reduce) {
    .role[data-state='active'] { animation: none; }
  }

  @container panel (max-width: 1000px) {
    .role { grid-template-columns: minmax(0, 1fr); overflow-y: auto; align-content: start; }
    .role-main { overflow: visible; }
  }

  /* Short windows: title and lede share a row, and the timeline tightens. */
  @container panel (max-height: 680px) and (min-width: 761px) {
    .exp-title { grid-template-columns: auto minmax(0, 1fr); align-items: center; column-gap: 28px; }
    .exp-title p { font-size: 0.9375rem; }
    .gantt { padding-top: 30px; gap: 6px; }
    .role-main { gap: 7px; }
    .role-points li { font-size: 0.875rem; }
  }

  /* Phones: no Gantt; every role in order, scrolling inside the panel. */
  @container panel (max-width: 760px) {
    .exp { display: flex; flex-direction: column; height: auto; }
    .exp-head { flex-direction: column; align-items: flex-start; }
    .gantt { display: none; }
    .roles { display: flex; flex-direction: column-reverse; gap: 36px; }
    .role { visibility: visible; opacity: 1; transform: none; overflow: visible; }
    .role-main { padding: 0; }
    .role-card { overflow: visible; }
    .examples { overflow: visible; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-exp]');
  if (root) {
    const bars = [...root.querySelectorAll<HTMLButtonElement>('[data-pick]')];
    const roles = [...root.querySelectorAll<HTMLElement>('[data-role]')];
    bars.forEach((b) =>
      b.addEventListener('click', () => {
        const i = Number(b.dataset.pick);
        bars.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        roles.forEach((r, j) => (j === i ? r.setAttribute('data-state', 'active') : r.removeAttribute('data-state')));
      }),
    );

  }
</script>
