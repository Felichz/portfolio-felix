---
import { Picture, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import type { Shot } from '../data/projects';

interface Props {
  shot: Shot;
  sizes: string;
  widths?: number[];
  /** Browser chrome above the screen, showing this address. */
  chrome?: string;
  zoom?: boolean;
  eager?: boolean;
  /** view-transition-name, so the frame can morph between pages. */
  vt?: string;
  /**
   * How the recording plays, when the shot has one.
   * hover: loops while the pointer is over it (in view, on touch screens).
   * lead: plays once when it scrolls into view, then settles on the still, which matches its last frame.
   * manual: rendered, but driven by the component around it (the work showcase).
   */
  motion?: 'hover' | 'lead' | 'manual';
  class?: string;
  style?: string;
}

const { shot, sizes, widths = [480, 800, 1200, 1600, 2000], chrome, zoom = true, eager = false, vt, motion, class: className, style } = Astro.props;
const single = shot.light === shot.dark;
const phone = !!shot.phone;
const w = phone ? [280, 420, 640] : widths;
const clip = motion && shot.motion && !shot.tape ? shot.motion : undefined;
const tape = motion && shot.tape ? shot.tape : undefined;

const full = async (src: ImageMetadata) => (await getImage({ src, format: 'webp', width: Math.min(src.width, 2880), quality: 84 })).src;
const zoomLight = zoom ? await full(shot.light) : undefined;
const zoomDark = zoom ? (single ? zoomLight : await full(shot.dark)) : undefined;

const common = {
  alt: shot.alt,
  formats: ['avif', 'webp'] as ('avif' | 'webp')[],
  fallbackFormat: 'webp' as const,
  widths: w,
  sizes,
  decoding: 'async' as const,
  // Both variants stay lazy: the hidden one is display:none, so the browser never fetches it.
  loading: (eager && single ? 'eager' : 'lazy') as 'eager' | 'lazy',
  fetchpriority: (eager ? 'high' : undefined) as 'high' | undefined,
};
const Tag = zoom ? 'button' : 'div';
const styles = [vt && `view-transition-name:${vt}`, style].filter(Boolean).join(';') || undefined;
---

<div
  class:list={['plate', phone && 'plate--phone', chrome && !phone && 'plate--chrome', className]}
  style={styles}
  data-motion={clip || tape ? motion : undefined}
  data-app={tape}
>
  {
    chrome && !phone && (
      <div class="plate-chrome">
        <span class="plate-dots" aria-hidden="true"><i /><i /><i /></span>
        <span class="plate-url" aria-hidden="true"><Icon name="lock" />{chrome}</span>
        <span class="plate-tools">
          {(clip || tape) && motion === 'lead' && (
            <button class="motion-btn" type="button" data-motion-play>
              <Icon name="play" class="motion-btn-play" />
              <Icon name="replay" class="motion-btn-replay" />
              <span class="motion-btn-play">Play recording</span>
              <span class="motion-btn-replay">Replay</span>
            </button>
          )}
        </span>
      </div>
    )
  }
  <div class="plate-screen">
    <Tag
      class:list={['plate-frame', zoom && 'zoom']}
      type={zoom ? 'button' : undefined}
      data-zoom-light={zoomLight}
      data-zoom-dark={zoomDark}
      data-motion-light={zoom ? clip?.light : undefined}
      data-motion-dark={zoom ? clip?.dark : undefined}
      data-alt={zoom ? shot.alt : undefined}
      aria-label={zoom ? `Enlarge screenshot: ${shot.caption ?? shot.alt}` : undefined}
    >
      {
        single ? (
          <Picture src={shot.dark} {...common} />
        ) : (
          <>
            {/* Inverted on purpose: the light site shows the product's dark edition, and the other way round. */}
            <Picture src={shot.dark} {...common} class="only-light" />
            <Picture src={shot.light} {...common} class="only-dark" />
          </>
        )
      }
      {
        tape && (
          <span class="plate-motion" aria-hidden="true">
            {/* The app's own DOM, replayed; one tape for both themes (src/scripts/tape.ts). */}
            <tape-player src={`/tapes/${tape}.json`} />
          </span>
        )
      }
      {
        clip && (
          <span class="plate-motion" aria-hidden="true">
            <video class="only-light" src={clip.dark} muted playsinline preload="none" disablepictureinpicture tabindex="-1" />
            <video class="only-dark" src={clip.light} muted playsinline preload="none" disablepictureinpicture tabindex="-1" />
          </span>
        )
      }
    </Tag>
    <slot />
  </div>
</div>

<style>
  .plate-tools { display: flex; justify-content: flex-end; min-width: 0; }
  .plate-chrome .motion-btn {
    height: 20px;
    padding: 0 8px 0 6px;
    gap: 5px;
    background: transparent;
    box-shadow: none;
    color: var(--chrome-ink);
    font-size: 0.6875rem;
  }
  .plate-chrome .motion-btn:hover { color: var(--chrome-ink); background: color-mix(in oklab, var(--chrome-ink) 16%, transparent); }
  .plate-chrome .motion-btn :global(.icon) { width: 11px; height: 11px; }
  @media (max-width: 560px) {
    .plate-url { display: none; }
  }
</style>

<script>
  import { editions, followThemeSwitches } from '../scripts/handoff';

  // Recordings never load until they play (preload="none"), and only the visible edition plays.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const hover = matchMedia('(hover: hover) and (pointer: fine)');

  const clipOf = (plate: HTMLElement) => editions(plate).from;

  function play(plate: HTMLElement, loop: boolean) {
    const v = clipOf(plate);
    if (!v) return;
    clearTimeout(Number(plate.dataset.stopTimer));
    v.loop = loop;
    if (v.ended || plate.dataset.state !== 'playing') v.currentTime = 0;
    plate.dataset.state = 'loading';
    // Reveal on the first painted frame, so there's never a blank flash while it loads.
    v.addEventListener(
      'playing',
      () => {
        if (plate.dataset.state === 'loading') plate.dataset.state = 'playing';
        else if (plate.dataset.state !== 'playing') v.pause();
      },
      { once: true },
    );
    v.play().catch(() => stop(plate));
  }

  function stop(plate: HTMLElement, state = 'idle') {
    plate.dataset.state = state;
    // Let the fade finish before rewinding, so the last frame doesn't jump.
    plate.dataset.stopTimer = String(
      setTimeout(() => {
        plate.querySelectorAll<HTMLVideoElement>('video, tape-player').forEach((v) => {
          v.pause();
          if (state === 'idle') v.currentTime = 0;
        });
      }, 400),
    );
  }

  // A lead recording waits until its panel is the active one; hover clips loop on touch screens while in view.
  const seen = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        const plate = e.target as HTMLElement;
        const mode = plate.dataset.motion;
        if (mode === 'lead') {
          if (e.intersectionRatio >= 0.5 && !plate.dataset.state && !reduce.matches) {
            seen.unobserve(plate);
            // Give the panel a moment to settle before the recording starts.
            setTimeout(() => play(plate, false), 350);
          }
        } else if (mode === 'hover' && !hover.matches && !reduce.matches) {
          if (e.intersectionRatio >= 0.6) play(plate, true);
          else if (plate.dataset.state === 'playing' || plate.dataset.state === 'loading') stop(plate);
        }
      }
    },
    { threshold: [0, 0.5, 0.6] },
  );

  document.querySelectorAll<HTMLElement>('.plate[data-motion]').forEach((plate) => {
    const mode = plate.dataset.motion;
    if (mode === 'manual') return;
    seen.observe(plate);
    plate.querySelectorAll('video, tape-player').forEach((v) =>
      v.addEventListener('ended', () => {
        if (mode === 'lead') stop(plate, 'done');
      }),
    );

    if (mode === 'lead') {
      if (reduce.matches) plate.dataset.state = 'idle';
      plate.querySelector('[data-motion-play]')?.addEventListener('click', () => play(plate, false));
      return;
    }
    plate.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse' && hover.matches && !reduce.matches) play(plate, true);
    });
    plate.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse' && hover.matches) stop(plate);
    });
  });

  // A theme switch hands every running recording to the other edition's video, on the same frame.
  followThemeSwitches(
    () => [...document.querySelectorAll<HTMLElement>('.plate[data-motion]:not([data-motion="manual"])')],
    (plate, to) => {
      if (plate.dataset.state === 'loading') to.addEventListener('playing', () => plate.dataset.state === 'loading' && (plate.dataset.state = 'playing'), { once: true });
    },
  );
</script>
