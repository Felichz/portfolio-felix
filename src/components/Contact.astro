---
import Icon from './Icon.astro';
---

<section id="contact" class="contact surface surface--night" data-paint aria-labelledby="contact-title">
  <div class="wrap">
    <h2 id="contact-title" class="contact-title">
      Hiring for a senior frontend role? I’d like to hear about it.
    </h2>

    <div class="contact-mail">
      <a class="contact-address" href="mailto:andersson.fx@gmail.com">andersson.fx@gmail.com</a>
      <button class="btn contact-copy" type="button" data-copy="andersson.fx@gmail.com">
        <Icon name="copy" />
        <span data-copy-label>Copy</span>
      </button>
    </div>

    <ul class="contact-links">
      <li>
        <a class="arrow-link" href="https://www.linkedin.com/in/felixandersson/" target="_blank" rel="noopener">
          LinkedIn <Icon name="arrow-up-right" />
        </a>
      </li>
      <li>
        <a class="arrow-link" href="https://github.com/Felichz" target="_blank" rel="noopener">
          GitHub <Icon name="arrow-up-right" />
        </a>
      </li>
      <li>
        <a class="arrow-link" href="/felix-andersson-resume.pdf" target="_blank" rel="noopener">
          Résumé, PDF <Icon name="arrow-up-right" />
        </a>
      </li>
      <li class="t-label contact-where">Montevideo, Uruguay · UTC−3 · Remote</li>
    </ul>

    <footer class="colophon">
      <p>
        <strong>Colophon.</strong> Set in Archivo, across its widths. Each product name is set in that product’s own typeface.
        Built with Astro, React and TypeScript. Screenshots captured from the live apps in September 2026, except LoLImpact’s
        match screens, which come from a local run.
      </p>
      <p class="t-num">© 2026 Felix Andersson</p>
    </footer>
  </div>
</section>

<style>
  .contact {
    padding-top: var(--section-y);
    padding-bottom: 40px;
  }
  .contact-title {
    font-size: clamp(2rem, 1.1rem + 3.2vw, 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 760;
    font-stretch: 94%;
    max-width: 18ch;
  }
  .contact-mail {
    margin-top: clamp(40px, 5vw, 72px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    padding-bottom: clamp(28px, 3vw, 40px);
    border-bottom: 1px solid var(--s-rule);
  }
  .contact-address {
    font-size: clamp(1.75rem, 0.6rem + 4.6vw, 5rem);
    line-height: 1;
    font-weight: 760;
    font-stretch: 104%;
    letter-spacing: -0.04em;
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0% 2px no-repeat;
    padding-bottom: 6px;
    transition: background-size 0.45s var(--ease-out);
  }
  .contact-address:hover { background-size: 100% 2px; }
  .contact-copy { --b-line: var(--s-rule); }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    align-items: center;
    padding-block: 28px;
  }
  .contact-where { margin-left: auto; }
  .colophon {
    margin-top: clamp(64px, 8vw, 120px);
    padding-top: 20px;
    border-top: 1px solid var(--s-rule);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 40px;
    color: var(--s-muted);
    font-size: 0.875rem;
  }
  .colophon p:first-child { max-width: 88ch; }
  .colophon strong { color: var(--s-ink); font-weight: 650; }

  @media (max-width: 700px) {
    .contact-where { margin-left: 0; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-copy-label]');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        if (label) label.textContent = 'Copied';
      } catch {
        // No clipboard access: select the address so a copy shortcut works.
        const address = document.querySelector('.contact-address');
        if (address) getSelection()?.selectAllChildren(address);
        if (label) label.textContent = 'Selected';
      }
      setTimeout(() => label && (label.textContent = 'Copy'), 2000);
    });
  });
</script>
