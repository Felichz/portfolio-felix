---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { ComponentProps } from 'astro/types';
import avatar from '../assets/portrait/felix-avatar.webp';

export interface PanelLink {
  id: string;
  label: string;
  icon: ComponentProps<typeof Icon>['name'];
}

interface Props {
  panels: PanelLink[];
  home: boolean;
}

const { panels, home } = Astro.props;
---

<header class="bar">
  <a class="brand" href={home ? '#intro' : '/'} aria-label={home ? 'Felix Andersson, back to the start' : 'Felix Andersson, home'}>
    <span class="brand-avatar">
      <Image src={avatar} alt="" widths={[64, 96]} sizes="32px" loading="eager" />
    </span>
    <span class="brand-text">
      <b>Felix Andersson</b>
      <small>Senior Frontend Engineer</small>
    </span>
  </a>

  <nav class="tabs" aria-label={home ? 'Sections' : 'Chapters'} data-tabs>
    <span class="tabs-pill" aria-hidden="true"></span>
    {
      panels.map((p, i) => (
        <a href={`#${p.id}`} data-tab={p.id} aria-current={i === 0 ? 'true' : undefined}>
          {p.label}
        </a>
      ))
    }
  </nav>

  <div class="bar-end">
    <p class="clock chip" title="Local time in Montevideo">
      <span class="pulse" aria-hidden="true"></span>
      <span class="clock-city">Montevideo</span>
      <time class="t-num" data-clock>--:--</time>
    </p>
    <button class="icon-btn icon-btn--sm theme" type="button" data-theme-toggle aria-label="Switch to dark theme">
      <Icon name="moon" class="for-light" />
      <Icon name="sun" class="for-dark" />
    </button>
    <a class="btn btn--solid btn--sm cv" href="/felix-andersson-resume.pdf" target="_blank" rel="noopener">
      <Icon name="file" />
      <span>Résumé</span>
    </a>
  </div>
</header>

<style>
  .bar {
    position: relative;
    z-index: 20;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    padding: 0 var(--gutter);
    view-transition-name: bar;
  }
  .bar::after {
    content: '';
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--line-2) 20%, var(--line-2) 80%, transparent);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    justify-self: start;
    min-width: 0;
    text-decoration: none;
    border-radius: 999px;
    padding: 4px 12px 4px 4px;
    margin-left: -4px;
    transition: background-color 0.25s var(--ease-out);
  }
  .brand:hover { background: color-mix(in oklab, var(--ink) 5%, transparent); }
  .brand-avatar {
    position: relative;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0 0 1px var(--line-2), 0 0 0 3px var(--bg), 0 0 0 4px color-mix(in oklab, var(--house) 45%, transparent);
  }
  .brand-avatar :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .brand-text { display: grid; line-height: 1.1; min-width: 0; }
  .brand-text b { font-weight: 760; font-stretch: 90%; font-size: 0.9875rem; letter-spacing: -0.01em; white-space: nowrap; }
  .brand-text small { font-size: 0.75rem; font-weight: 520; color: var(--ink-3); white-space: nowrap; }

  .tabs {
    position: relative;
    display: flex;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: var(--surface);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: inset 0 1px 0 var(--hi), 0 0 0 1px var(--line);
  }
  .tabs a {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 15px;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    font-stretch: 92%;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.3s var(--ease-out);
  }
  .tabs a:hover { color: var(--ink); }
  .tabs a[aria-current='true'] { color: var(--bg); }
  .tabs-pill {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: var(--pill-w, 0);
    border-radius: 999px;
    background: var(--ink);
    box-shadow: 0 6px 16px -8px color-mix(in oklab, var(--ink) 70%, transparent);
    transform: translateX(var(--pill-x, 4px));
    transition: transform 0.55s var(--ease-out), width 0.55s var(--ease-out);
  }
  .tabs:not([data-ready]) .tabs-pill { transition: none; }

  .bar-end { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }
  .clock { color: var(--ink-2); margin-right: 4px; }
  .clock time { color: var(--ink); font-weight: 700; }
  .theme :global(svg) { width: 17px; height: 17px; }
  :global(:root[data-theme='dark']) .theme :global(.for-light),
  :global(:root:not([data-theme='dark'])) .theme :global(.for-dark) { display: none; }

  @media (max-width: 1180px) {
    .clock-city { display: none; }
  }
  @media (max-width: 1020px) {
    .brand-text small { display: none; }
    .clock { display: none; }
  }
  @media (max-width: 760px) {
    .bar { grid-template-columns: minmax(0, 1fr) auto; }
    .tabs { display: none; }
    .cv span { display: none; }
    .cv { width: 36px; padding: 0; }
  }
</style>

<script>
  // Montevideo's local time, so a remote team can see the overlap at a glance.
  const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
  if (clock) {
    const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'America/Montevideo', hour: '2-digit', minute: '2-digit' });
    const tick = () => (clock.textContent = fmt.format(new Date()));
    tick();
    setTimeout(() => {
      tick();
      setInterval(tick, 60_000);
    }, 60_000 - (Date.now() % 60_000));
  }

  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const label = () => btn?.setAttribute('aria-label', `Switch to ${root.dataset.theme === 'dark' ? 'light' : 'dark'} theme`);
  label();
  btn?.addEventListener('click', (e) => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    const apply = () => {
      root.dataset.theme = next;
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#0a0a0c' : '#f2f1ed');
      try {
        localStorage.setItem('fa-theme', next);
      } catch {}
      label();
    };
    // The new edition spreads out in a circle from the toggle, where the browser supports it.
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const doc = document as Document & { startViewTransition?: (cb: () => void) => { finished: Promise<void> } };
    if (!doc.startViewTransition || reduce) return apply();
    root.style.setProperty('--vt-x', `${e.clientX || innerWidth}px`);
    root.style.setProperty('--vt-y', `${e.clientY || 0}px`);
    root.dataset.vt = 'theme';
    doc.startViewTransition(apply).finished.finally(() => delete root.dataset.vt);
  });
</script>
