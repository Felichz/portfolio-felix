---
import Icon from './Icon.astro';
import type { ComponentProps } from 'astro/types';

export interface PanelLink {
  id: string;
  label: string;
  icon: ComponentProps<typeof Icon>['name'];
}

interface Props {
  panels: PanelLink[];
  home: boolean;
}

const { panels, home } = Astro.props;
---

<header class="bar">
  <a class="brand" href={home ? '#intro' : '/'}>
    <span class="brand-mark" aria-hidden="true">FA</span>
    <span class="brand-text">
      <b>Felix Andersson</b>
      <small>Senior Frontend Engineer</small>
    </span>
    <span class="visually-hidden">{home ? ', back to the start' : ', home'}</span>
  </a>

  <nav class="tabs" aria-label={home ? 'Sections' : 'Chapters'} data-tabs>
    <span class="tabs-pill" aria-hidden="true"></span>
    {
      panels.map((p, i) => (
        <a href={`#${p.id}`} data-tab={p.id} aria-current={i === 0 ? 'true' : undefined}>
          {p.label}
        </a>
      ))
    }
  </nav>

  <div class="bar-end">
    <p class="clock chip" title="Local time in Montevideo">
      <span class="clock-city">Montevideo</span>
      <time class="t-num" data-clock>--:--</time>
    </p>
    <button class="icon-btn icon-btn--sm theme" type="button" data-theme-toggle aria-label="Switch to dark theme">
      <Icon name="moon" class="for-light" />
      <Icon name="sun" class="for-dark" />
    </button>
    <a class="btn btn--solid btn--sm cv" href="/felix-andersson-resume.pdf" target="_blank" rel="noopener">
      <Icon name="file" />
      <span>Résumé</span>
    </a>
  </div>
</header>

<style>
  .bar {
    position: relative;
    z-index: 20;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    padding: 0 var(--gutter);
    view-transition-name: bar; /* (named elements: see .live-vt in global.css) */
  }
  .bar::after {
    content: '';
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--line-2) 20%, var(--line-2) 80%, transparent);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    justify-self: start;
    min-width: 0;
    text-decoration: none;
    border-radius: 999px;
    padding: 4px 12px 4px 4px;
    margin-left: -4px;
    transition: background-color 0.25s var(--ease-out);
  }
  .brand:hover { background: color-mix(in oklab, var(--ink) 5%, transparent); }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 10px;
    background: var(--ink);
    color: var(--bg);
    font-size: 0.8125rem;
    font-weight: 820;
    font-stretch: 118%;
    letter-spacing: -0.02em;
  }
  .brand-text { display: grid; line-height: 1.1; min-width: 0; }
  .brand-text b { font-weight: 760; font-stretch: 90%; font-size: 0.9875rem; letter-spacing: -0.01em; white-space: nowrap; }
  .brand-text small { font-size: 0.75rem; font-weight: 520; color: var(--ink-3); white-space: nowrap; }

  .tabs {
    position: relative;
    display: flex;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: inset 0 1px 0 var(--hi), 0 0 0 1px var(--line);
  }
  .tabs a {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 15px;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    font-stretch: 92%;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.3s var(--ease-out);
  }
  .tabs a:hover { color: var(--ink); }
  .tabs a[aria-current='true'] { color: var(--bg); }
  .tabs-pill {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: var(--pill-w, 0);
    border-radius: 999px;
    background: var(--ink);
    box-shadow: 0 6px 16px -8px color-mix(in oklab, var(--ink) 70%, transparent);
    transform: translateX(var(--pill-x, 4px));
    transition: transform 0.55s var(--ease-out), width 0.55s var(--ease-out);
  }
  .tabs:not([data-ready]) .tabs-pill { transition: none; }

  .bar-end { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }
  .clock { color: var(--ink-2); margin-right: 4px; }
  .clock time { color: var(--ink); font-weight: 700; }
  .theme :global(svg) { width: 17px; height: 17px; }
  :global(:root[data-theme='dark']) .theme :global(.for-light),
  :global(:root:not([data-theme='dark'])) .theme :global(.for-dark) { display: none; }

  @media (max-width: 1180px) {
    .clock-city { display: none; }
  }
  @media (max-width: 1020px) {
    .brand-text small { display: none; }
    .clock { display: none; }
  }
  @media (max-width: 760px) {
    .bar { grid-template-columns: minmax(0, 1fr) auto; }
    .tabs { display: none; }
    .cv span { display: none; }
    .cv { width: 36px; padding: 0; }
  }
</style>

<script>
  // Montevideo's local time, so a remote team can see the overlap at a glance.
  const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
  if (clock) {
    const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'America/Montevideo', hour: '2-digit', minute: '2-digit' });
    const tick = () => (clock.textContent = fmt.format(new Date()));
    tick();
    setTimeout(() => {
      tick();
      setInterval(tick, 60_000);
    }, 60_000 - (Date.now() % 60_000));
  }

  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const label = () => btn?.setAttribute('aria-label', `Switch to ${root.dataset.theme === 'dark' ? 'light' : 'dark'} theme`);
  label();
  // (A copy of this site running inside itself gets its theme from the page around it.)
  new MutationObserver(label).observe(root, { attributes: true, attributeFilter: ['data-theme'] });

  /**
   * Switches the site's theme: the new edition fades in over the whole page. A live app on the page
   * (src/scripts/live.ts) passes on a theme it switched itself through this too.
   */
  let busy = false;
  const switchTheme = () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    // Recordings hand off to the other edition's video on the same frame (src/scripts/handoff.ts);
    // the new edition shows once they're on it, or after a short cap.
    const waits: Promise<unknown>[] = [];
    document.dispatchEvent(new CustomEvent('theme:switch', { detail: { theme: next, waitUntil: (p: Promise<unknown>) => waits.push(p) } }));
    const apply = () => {
      root.dataset.theme = next;
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#0a0a0c' : '#f2f1ed');
      try {
        localStorage.setItem('fa-theme', next);
      } catch {}
      label();
      return Promise.all(waits);
    };
    // A wash of the new edition's background covers the page, the theme flips under it, and the wash
    // lifts off the new page. The flip repaints everything (the page, and every preview in its own
    // process); under an opaque layer that frame is never seen, and the only motion is that layer's
    // opacity, which the compositor runs on its own. (A circle from the toggle, then a cross-fade of
    // two snapshots, both repainted or recomposited the whole page while moving.)
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Previews (src/scripts/player.ts) take the new edition with the page, under the wash.
    const reveal = () => document.dispatchEvent(new CustomEvent('theme:reveal'));
    if (busy) return;
    const done = () => requestAnimationFrame(() => requestAnimationFrame(() => root.removeAttribute('data-theme-switching')));
    if (reduce) {
      root.setAttribute('data-theme-switching', '');
      void apply();
      reveal();
      return done();
    }
    busy = true;
    const wash = document.createElement('div');
    wash.className = 'theme-wash';
    wash.style.background = next === 'dark' ? '#0a0a0c' : '#f2f1ed';
    document.body.append(wash);
    const frame = () => new Promise((r) => requestAnimationFrame(r));
    void (async () => {
      await wash.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 160, easing: 'cubic-bezier(0.4, 0, 1, 1)', fill: 'forwards' }).finished;
      // Transitions stay suspended across the flip (set now, under the wash: it restyles the page too).
      root.setAttribute('data-theme-switching', '');
      reveal();
      await Promise.race([apply(), new Promise((r) => setTimeout(r, 200))]);
      // Two frames: the new page styled, painted and committed before the wash lifts.
      await frame();
      await frame();
      await wash.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 260, easing: 'cubic-bezier(0, 0, 0.2, 1)', fill: 'forwards' }).finished;
      wash.remove();
      busy = false;
      done();
    })();
  };
  window.__faTheme = switchTheme;

  btn?.addEventListener('click', () => {
    // In a copy of this site running inside itself, the switch is the page's around it: both fade over
    // together.
    const host = window !== window.top && window.frameElement ? (window.parent as Window) : undefined;
    if (host?.__faTheme) return host.__faTheme();
    switchTheme();
  });
</script>
