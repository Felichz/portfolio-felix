---
/**
 * Schematic of the main thread while filtering a large table.
 * Top lane: one long task, input and frames wait. Bottom lane: short slices with
 * room for input and paint between them, and results rendered as they arrive.
 */
const W = 640;
const x0 = 96;
const span = W - x0 - 16;
const at = (t: number) => x0 + (t / 320) * span; // t in schematic ms

const slices = Array.from({ length: 16 }, (_, i) => i * 20);
const keysBlocked = [24, 88, 150];
const keysSliced = [24, 88, 150];
const frames = Array.from({ length: 20 }, (_, i) => i * 16.7).filter((t) => t < 320);
---

<svg class="mt" viewBox={`0 0 ${W} 250`} role="img" aria-labelledby="mt-title mt-desc">
  <title id="mt-title">Main thread, blocking versus sliced filtering</title>
  <desc id="mt-desc">
    In the blocking lane one long task filters every row; keystrokes and frames wait until it ends. In the sliced lane the
    same work runs in short slices with keystrokes and frames handled between them, and the first results appear after the
    first slice.
  </desc>

  <!-- Lane labels -->
  <text x="0" y="62" class="mt-lane">Blocking</text>
  <text x="0" y="78" class="mt-sub">one long task</text>
  <text x="0" y="172" class="mt-lane">Sliced</text>
  <text x="0" y="188" class="mt-sub">yields between</text>

  <!-- Lane rails -->
  <line x1={x0} x2={W - 16} y1="96" y2="96" class="mt-rail" />
  <line x1={x0} x2={W - 16} y1="206" y2="206" class="mt-rail" />

  <!-- Blocking: one task, input queued, no frames until it ends -->
  <rect x={at(0)} y="54" width={at(260) - at(0)} height="34" rx="4" class="mt-task" />
  <text x={at(8)} y="75" class="mt-in">filter 100,000 rows</text>
  {
    keysBlocked.map((t) => (
      <g>
        <path d={`M${at(t)} 30 l-5 -8 h10 z`} class="mt-key" />
        <line x1={at(t)} x2={at(262)} y1="38" y2="38" class="mt-wait" />
      </g>
    ))
  }
  <text x={at(262) + 6} y="42" class="mt-note">input waits</text>
  {frames.filter((t) => t > 262).map((t) => <rect x={at(t)} y="100" width="3" height="8" class="mt-frame" />)}
  <text x={at(0)} y="122" class="mt-note">no frames painted while it runs</text>

  <!-- Sliced: short tasks, input and frames in between, results early -->
  {slices.map((t) => <rect x={at(t)} y="164" width={at(t + 11) - at(t)} height="34" rx="3" class="mt-task" />)}
  {
    keysSliced.map((t) => (
      <g>
        <path d={`M${at(t)} 140 l-5 -8 h10 z`} class="mt-key" />
        <line x1={at(t)} x2={at(t)} y1="146" y2="160" class="mt-handled" />
      </g>
    ))
  }
  {frames.map((t) => <rect x={at(t)} y="210" width="3" height="8" class="mt-frame" />)}
  <line x1={at(11)} x2={at(11)} y1="160" y2="232" class="mt-first" />
  <text x={at(11) + 6} y="240" class="mt-note mt-note--strong">first results render here</text>

  <!-- Legend -->
  <g transform="translate(0 0)">
    <path d="M101 8 l-5 -8 h10 z" transform="translate(0 6)" class="mt-key" />
    <text x="112" y="12" class="mt-note">keystroke</text>
    <rect x="186" y="4" width="3" height="8" class="mt-frame" />
    <text x="196" y="12" class="mt-note">frame painted</text>
    <rect x="290" y="3" width="16" height="10" rx="2" class="mt-task" />
    <text x="312" y="12" class="mt-note">filtering work</text>
  </g>
</svg>

<style>
  .mt { width: 100%; height: auto; overflow: visible; font-family: var(--font); }
  .mt-lane { font-size: 14px; font-weight: 700; font-stretch: 92%; fill: var(--ink); }
  .mt-sub { font-size: 11.5px; font-weight: 500; font-stretch: 86%; fill: var(--ink-3); }
  .mt-note { font-size: 11.5px; font-weight: 550; font-stretch: 86%; fill: var(--ink-2); }
  .mt-note--strong { fill: var(--ink); font-weight: 650; }
  .mt-in { font-size: 12px; font-weight: 600; font-stretch: 90%; fill: var(--paper); }
  .mt-rail { stroke: var(--rule-2); stroke-width: 1; }
  .mt-task { fill: var(--ink); }
  .mt-key { fill: var(--ink-2); }
  .mt-wait { stroke: var(--ink-3); stroke-width: 1; stroke-dasharray: 3 3; }
  .mt-handled { stroke: var(--ink-2); stroke-width: 1; }
  .mt-frame { fill: var(--ink-3); }
  .mt-first { stroke: var(--ink); stroke-width: 1; stroke-dasharray: 2 3; }
</style>
