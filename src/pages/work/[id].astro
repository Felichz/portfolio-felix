---
import type { GetStaticPaths } from 'astro';
import CaseStudy from '../../components/CaseStudy.astro';
import { projects, type Project } from '../../data/projects';

export const getStaticPaths = (() => projects.map((project) => ({ params: { id: project.id }, props: { project } }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
}
---

<CaseStudy project={Astro.props.project} />
