---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Plate from '../../components/Plate.astro';
import Icon from '../../components/Icon.astro';
import { projects, type Project } from '../../data/projects';

export const getStaticPaths = (() =>
  projects.map((project, i) => ({
    params: { id: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length]!,
      next: projects[(i + 1) % projects.length]!,
      index: i,
    },
  }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
  prev: Project;
  next: Project;
  index: number;
}

const { project: p, prev, next, index } = Astro.props;
const accent = `--a-light:${p.accent.light};--a-dark:${p.accent.dark};--on-light:${p.accent.onLight};--on-dark:${p.accent.onDark}`;
const faceClass = (name: string) => `face-${name.toLowerCase().replace(/\s+/g, '-')}`;
---

<Base title={`${p.name}, case study · Felix Andersson`} description={p.tagline}>
  <article class="cs" data-accent style={accent} data-prev={`/work/${prev.id}/`} data-next={`/work/${next.id}/`}>
    <header class="wrap cs-head">
      <a class="cs-back arrow-link" href={`/#work`}><Icon name="arrow-left" class="icon-left" />All work</a>
      <p class="t-label t-num cs-count"><span class="cs-index">{String(index + 1).padStart(2, '0')}</span> / {String(projects.length).padStart(2, '0')}</p>
      <h1 class={`cs-name ${p.face}`} style={`view-transition-name:name-${p.id}`}>
        {
          p.wordmark ? (
            <>
              <b>{p.wordmark[0]}</b>
              {p.wordmark[1]}
            </>
          ) : (
            p.name
          )
        }
      </h1>
      <p class="t-lede cs-tagline">{p.tagline}</p>
      <div class="cs-actions">
        <a class="btn btn--solid" href={p.live} target="_blank" rel="noopener">Open the live app <Icon name="arrow-up-right" /></a>
        <a class="btn" href={p.source} target="_blank" rel="noopener"><Icon name="github" />Source</a>
      </div>
      <dl class="cs-facts">
        <div><dt class="t-label">Role</dt><dd>{p.role}</dd></div>
        <div><dt class="t-label">Year</dt><dd class="t-num">{p.year}</dd></div>
        <div><dt class="t-label">Interface</dt><dd>{p.language}{p.onlyDark ? ', dark only' : ', light and dark'}</dd></div>
      </dl>
    </header>

    <div class="wrap cs-stage">
      <Plate shot={p.main} crop eager vt={`shot-${p.id}`} sizes="(min-width: 1440px) 1360px, 94vw" widths={[640, 960, 1360, 1800, 2400]}>
        {
          p.callouts.map((c, i) => (
            <button
              type="button"
              class="pin pin--live"
              style={`left:${c.x}%;top:${c.y}%`}
              data-pin={i + 1}
              data-x={c.x < 28 ? 'start' : c.x > 72 ? 'end' : 'mid'}
              data-y={c.y < 22 ? 'below' : 'above'}
              aria-describedby={`tip-${p.id}-${i + 1}`}
              aria-label={`Detail ${i + 1}`}
            >
              {i + 1}
              <span class="pin-tip" role="tooltip" id={`tip-${p.id}-${i + 1}`}>
                {c.text}
              </span>
            </button>
          ))
        }
      </Plate>
    </div>

    <div class="wrap cs-body">
      <div class="prose cs-story">
        {p.story.map((para) => <p>{para}</p>)}
        {p.liveNote && <p class="cs-note">{p.liveNote}</p>}
      </div>
      <ol class="cs-callouts" aria-label="Details in the screenshot">
        {
          p.callouts.map((c, i) => (
            <li data-callout={i + 1}>
              <span class="pin pin--static" aria-hidden="true">{i + 1}</span>
              <span>{c.text}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <ul class="wrap cs-highlights">
      {
        p.highlights.map((h) => (
          <li>
            <h2>{h.title}</h2>
            <p>{h.body}</p>
          </li>
        ))
      }
    </ul>

    <section class="wrap cs-gallery" aria-label={`More screens from ${p.name}`}>
      {
        p.gallery.map((s) => (
          <figure class:list={['cs-shot', s.phone && 'cs-shot--phone']}>
            <Plate shot={s} sizes={s.phone ? '240px' : '(min-width: 1100px) 44vw, 92vw'} widths={[480, 800, 1200]} />
            {s.caption && <figcaption class="t-label">{s.caption}</figcaption>}
          </figure>
        ))
      }
    </section>

    <dl class="wrap cs-sheet">
      <div class="cs-sheet-wide"><dt class="t-label">Stack</dt><dd>{p.stack.join(', ')}</dd></div>
      <div><dt class="t-label">Scale</dt><dd><ul class="t-num">{p.scale.map((s) => <li>{s}</li>)}</ul></dd></div>
      <div>
        <dt class="t-label">Typefaces</dt>
        <dd>
          <ul class="cs-faces">
            {p.typefaces.map((f) => (
              <li>
                <span class={`cs-aa ${faceClass(f)}`} aria-hidden="true">Aa</span>
                <span class={faceClass(f)}>{f}</span>
              </li>
            ))}
          </ul>
        </dd>
      </div>
      <div>
        <dt class="t-label">Palette</dt>
        <dd class="cs-palette">
          {p.palette.map((hex) => <span style={`background:${hex}`} title={hex} />)}
        </dd>
      </div>
    </dl>

    <nav class="wrap cs-pager" aria-label="More case studies">
      <a class="pager-link" href={`/work/${prev.id}/`} rel="prev">
        <span class="t-label"><Icon name="arrow-left" class="icon-left" /> Previous</span>
        <span class={`pager-name ${prev.face}`}>{prev.name}</span>
      </a>
      <p class="pager-hint t-label">
        <kbd><Icon name="chevron-left" /></kbd><kbd><Icon name="chevron-right" /></kbd> to browse
      </p>
      <a class="pager-link pager-link--next" href={`/work/${next.id}/`} rel="next">
        <span class="t-label">Next <Icon name="arrow-right" class="icon-right" /></span>
        <span class={`pager-name ${next.face}`}>{next.name}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .cs { padding-bottom: 40px; }
  .cs-head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-areas:
      'back count'
      'name name'
      'tag actions'
      'facts facts';
    gap: 20px clamp(32px, 5vw, 80px);
    align-items: end;
    padding-top: clamp(28px, 3.4vw, 48px);
  }
  .cs-back { grid-area: back; justify-self: start; }
  .cs-count { grid-area: count; justify-self: end; }
  .cs-index { color: var(--accent); }
  .cs-name {
    grid-area: name;
    margin-top: clamp(12px, 2vw, 28px);
    font-size: clamp(3rem, 1rem + 6.4vw, 5.75rem);
    line-height: 0.95;
    font-weight: inherit;
    letter-spacing: -0.035em;
  }
  .cs-name.face-martian { font-weight: 400; letter-spacing: -0.02em; font-size: clamp(2.5rem, 0.8rem + 5.4vw, 5rem); }
  .cs-name.face-martian b { font-weight: 700; }
  .cs-name.face-inter { letter-spacing: -0.04em; }
  .cs-tagline { grid-area: tag; max-width: 52ch; color: var(--ink-2); }
  .cs-actions { grid-area: actions; display: flex; flex-wrap: wrap; gap: 10px; justify-content: flex-end; }
  .cs-facts {
    grid-area: facts;
    display: grid;
    grid-template-columns: 2fr 1fr 1.4fr;
    border-block: 1px solid var(--rule);
    margin-top: 12px;
  }
  .cs-facts > div { padding: 12px 16px 12px 0; display: grid; gap: 2px; }
  .cs-facts > div + div { padding-left: 16px; border-left: 1px solid var(--rule); }
  .cs-facts dd { font-weight: 560; font-size: 0.975rem; }

  .cs-stage { margin-top: clamp(40px, 5vw, 72px); }

  .cs-body {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 40px clamp(32px, 5vw, 80px);
    margin-top: clamp(48px, 6vw, 88px);
    align-items: start;
  }
  .cs-story { font-size: clamp(1.0625rem, 1rem + 0.2vw, 1.1875rem); }
  .cs-note { font-size: 0.9375rem; color: var(--ink-2); padding-top: 12px; border-top: 1px solid var(--rule); }
  .cs-callouts { display: grid; gap: 16px; padding-top: 4px; }
  .cs-callouts li { display: flex; gap: 14px; align-items: flex-start; color: var(--ink-2); font-size: 0.975rem; transition: color 0.2s var(--ease-out); }
  .cs-callouts li:hover { color: var(--ink); }

  .cs-highlights {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(56px, 7vw, 96px);
  }
  .cs-highlights li { padding: 20px clamp(16px, 2vw, 32px) 4px 0; border-top: 1px solid var(--ink); }
  .cs-highlights li + li { padding-left: clamp(16px, 2vw, 32px); }
  .cs-highlights h2 { font-size: 1.1875rem; line-height: 1.25; font-weight: 720; font-stretch: 94%; letter-spacing: -0.01em; margin-bottom: 10px; }
  .cs-highlights p { color: var(--ink-2); font-size: 0.975rem; line-height: 1.55; }

  .cs-gallery {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(20px, 2.6vw, 36px);
    margin-top: clamp(56px, 7vw, 96px);
    align-items: flex-start;
  }
  .cs-shot { flex: 1 1 calc(50% - 36px); min-width: min(100%, 420px); display: grid; gap: 10px; }
  .cs-shot--phone { flex: 0 0 clamp(170px, 18vw, 240px); min-width: 0; }

  .cs-sheet {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    margin-top: clamp(56px, 7vw, 96px);
    border-block: 1px solid var(--rule);
  }
  .cs-sheet > div { padding: 16px 20px 18px 0; display: grid; gap: 8px; align-content: start; font-size: 0.9375rem; }
  .cs-sheet > div + div { padding-left: 20px; border-left: 1px solid var(--rule); }
  .cs-sheet li + li { margin-top: 2px; }
  .cs-faces { display: grid; gap: 8px; }
  .cs-faces li { display: flex; align-items: baseline; gap: 12px; font-size: 1.0625rem; }
  .cs-aa { font-size: 2rem; line-height: 1; min-width: 1.35em; }
  .cs-palette { display: flex; gap: 6px; flex-wrap: wrap; }
  .cs-palette span { width: 22px; height: 22px; border-radius: 6px; box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 18%, transparent); }

  .cs-pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 20px;
    margin-top: clamp(64px, 8vw, 120px);
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }
  .pager-link { display: grid; gap: 6px; text-decoration: none; }
  .pager-link .t-label { display: inline-flex; align-items: center; gap: 6px; }
  .pager-link--next { justify-items: end; text-align: right; }
  .pager-name { font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.75rem); line-height: 1; letter-spacing: -0.03em; transition: color 0.2s var(--ease-out); }
  .pager-name.face-martian { font-size: clamp(1.375rem, 1rem + 1.4vw, 2.125rem); letter-spacing: 0; }
  .pager-link:hover .pager-name { color: var(--ink-2); }
  .pager-link :global(.icon) { width: 14px; height: 14px; transition: transform 0.3s var(--ease-out); }
  .pager-link:hover :global(.icon-left) { transform: translateX(-3px); }
  .pager-link:hover :global(.icon-right) { transform: translateX(3px); }
  .pager-hint { display: flex; align-items: center; gap: 6px; }
  kbd {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1px solid var(--rule-2);
    border-bottom-width: 2px;
    border-radius: 5px;
  }
  kbd :global(.icon) { width: 12px; height: 12px; }

  @media (max-width: 1000px) {
    .cs-head {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'back count' 'name name' 'tag tag' 'actions actions' 'facts facts';
    }
    .cs-actions { justify-content: flex-start; }
    .cs-body { grid-template-columns: minmax(0, 1fr); }
    .cs-sheet { grid-template-columns: 1fr 1fr; }
    .cs-sheet-wide { grid-column: 1 / -1; }
    .cs-sheet > div:nth-child(2) { padding-left: 0; border-left: 0; }
    .cs-sheet > div:nth-child(n + 2) { border-top: 1px solid var(--rule); }
  }
  @media (max-width: 700px) {
    .cs-facts { grid-template-columns: minmax(0, 1fr); }
    .cs-facts > div + div { padding-left: 0; border-left: 0; border-top: 1px solid var(--rule); }
    .cs-highlights { grid-template-columns: minmax(0, 1fr); }
    .cs-highlights li + li { padding-left: 0; }
    .cs-sheet { grid-template-columns: minmax(0, 1fr); }
    .cs-sheet > div { padding-left: 0 !important; border-left: 0 !important; }
    .cs-shot--phone { flex-basis: 46%; }
    .pager-hint { display: none; }
    .cs-pager { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  // Callout legend lights its pin, and a lit pin shows its tooltip.
  document.querySelectorAll<HTMLElement>('.cs').forEach((cs) => {
    const pins = cs.querySelectorAll<HTMLElement>('.cs-stage .pin');
    cs.querySelectorAll<HTMLElement>('[data-callout]').forEach((item) => {
      const pin = pins[Number(item.dataset.callout) - 1];
      if (!pin) return;
      item.addEventListener('pointerenter', () => pin.setAttribute('data-lit', ''));
      item.addEventListener('pointerleave', () => pin.removeAttribute('data-lit'));
    });

    // Left and right arrows move between case studies, unless something else wants the keys.
    addEventListener('keydown', (e) => {
      if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
      const t = e.target as HTMLElement;
      if (t.closest('input, textarea, select, [contenteditable], dialog[open]') || document.querySelector('dialog[open]')) return;
      if (e.key === 'ArrowLeft' && cs.dataset.prev) location.href = cs.dataset.prev;
      if (e.key === 'ArrowRight' && cs.dataset.next) location.href = cs.dataset.next;
    });
  });
</script>
