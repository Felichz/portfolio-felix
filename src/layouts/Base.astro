---
import '../styles/global.css';
import Bar from '../components/Bar.astro';
import Dock from '../components/Dock.astro';
import Viewer from '../components/Viewer.astro';
import type { PanelLink } from '../components/Bar.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** The panels of this page, in order: they drive the bar tabs, the dock and the deck. */
  panels: PanelLink[];
  /** Where the brand link and the dock's back action point. */
  home?: boolean;
}

const { title, description, image = '/og.png', panels, home = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Felix Andersson',
  jobTitle: 'Senior Frontend Engineer',
  email: 'mailto:andersson.fx@gmail.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Montevideo', addressCountry: 'UY' },
  url: Astro.site?.toString(),
  sameAs: ['https://github.com/Felichz', 'https://www.linkedin.com/in/felixandersson/'],
  knowsAbout: ['React', 'TypeScript', 'Design systems', 'Frontend performance', 'Accessibility'],
};
---

<!doctype html>
<html lang="en" class="app">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f2f1ed" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo-wdth.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Theme before first paint: saved choice, else the system setting. -->
    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        let t = null;
        try { t = localStorage.getItem('fa-theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.dataset.theme = t;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', t === 'dark' ? '#0a0a0c' : '#f2f1ed');
      })();
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <div class="ambient" aria-hidden="true"><div class="ambient-dots"></div></div>
    <div class="cursor-light" aria-hidden="true"><div class="ambient-light" data-light></div><canvas class="ambient-field" data-field></canvas></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <Bar panels={panels} home={home} />
    <Dock panels={panels} />
    <main id="main" class="stage" data-deck tabindex="-1">
      <slot />
    </main>
    <Viewer />

    <!-- Open on the panel the URL names before the first paint, so a deep link never flashes the intro. -->
    <script is:inline>
      (() => {
        const stage = document.querySelector('[data-deck]');
        if (!stage) return;
        const panels = [...stage.children].filter((p) => p.classList.contains('panel'));
        const id = decodeURIComponent(location.hash.slice(1)).split('/')[0];
        const i = Math.max(0, panels.findIndex((p) => p.id === id));
        if (i > 0) stage.scrollTop = panels[i].offsetTop;
        panels[i]?.setAttribute('data-active', '');
        panels[i]?.setAttribute('data-seen', '');
        // If the scripts never arrive, show everything rather than waiting on reveals that won't run.
        setTimeout(() => document.documentElement.hasAttribute('data-deck-ready') || document.documentElement.classList.remove('js'), 4000);
      })();
    </script>
  </body>
</html>

<script>
  import { initDeck } from '../scripts/deck';
  import { initFx } from '../scripts/fx';
  import { initField } from '../scripts/field';
  import { initThaw } from '../scripts/thaw';

  initDeck();
  initFx();
  initThaw();
  initField();
</script>
